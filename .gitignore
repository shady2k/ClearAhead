
# Beads / Dolt files (added by bd init)
.dolt/
*.db
# Спутники SQLite в режиме WAL. База мира с 2026-08-12 открывается журналом
# WAL (worldstore.dsnPragmas), и рядом с world.db появляются два файла, которых
# прежде не было: `*.db` их шаблоном не ловит — точка перед суффиксом там
# отсутствует.
*.db-wal
*.db-shm
*.db-journal
.beads-credential-key
.beads/proxieddb/

# Собранный сервер. `go build` в каталоге server кладёт бинарь рядом с
# исходниками — 16 МБ, воспроизводимых одной командой; в истории им делать
# нечего.
/server/clearahead

# Выгрузка графа кода (graphify). Производная от исходников, 22 МБ, полностью
# перестраивается `graphify update .` — версионируется источник, а не индекс.
/graphify-out/

# Godot
.godot/
*.uid
export_presets.cfg

# macOS
.DS_Store

# .nodeterm — состояние холста nodeterm: оснастка рабочего места, а не проекта.
.nodeterm/

# Снимки экрана. shots/ — вывод `make client-shot`, `make turnout-probe` и
# стенда: кадр, чтобы посмотреть глазами. Расходный материал разбора — за один
# день их набегает четыре десятка на полсотни мегабайт, и в истории им делать
# нечего: воспроизводятся той же командой.
#
# Снимок, который ДОКУМЕНТИРУЕТ (кадр роли, стенд механизма, состояние, на
# которое ссылается запись), кладётся в историю осознанно: `git add -f`. Таких
# в проекте 13, и они уже отслеживаются — правило их не выбрасывает.
/shots/
