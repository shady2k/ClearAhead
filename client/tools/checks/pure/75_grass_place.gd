## ПУЧОК НЕ ЕДЕТ ЗА КАМЕРОЙ, А КРУГ ЕДЕТ — и путать эти два «едет» нельзя. Первым
## куплена жалоба владельца «трава постоянно прыгает и меняет своё место и вид» и
## «пятна какие-то постоянно перемещаются»: место пучка обязано быть функцией
## МЕСТА, чтобы пересадка круга не переставляла луг. Второе — про сам круг: он
## обязан перецентрироваться вслед за взглядом, иначе отъедет за спину.
##
## Картинка тут не проверяется ни разу — проверяется то, на чём она держится, и
## оба свойства такие: сломайся первое, и пересадка переставит луг целиком;
## сломайся второе, и луг останется там, откуда уехали. Увидел бы и то и другое
## владелец, а не мы.
##
## Утверждения, и каждое отвечает своему способу сломать посадку. Первые четыре —
## про ЖРЕБИЙ ПУЧКА, пятое и шестое — про САМ КРУГ; вторая пара дописана
## 2026-08-15 вместе с починкой ClearAhead-x84y, и её довод записан на месте.
##
##   1. Жребий ячейки не зависит ни от чего, кроме её индексов: ни от порядка
##      вызовов, ни от соседей, ни от номера кадра.
##   2. Сдвиг пучка НЕ ВЫХОДИТ ЗА СВОЮ БАЗОВУЮ ЯЧЕЙКУ. Это и есть то, из-за чего
##      кольца можно сажать на одной сетке: кольцо берёт каждую k-ю ячейку, и
##      пока пучок сидит внутри своей, дальняя трава стоит В ТЕХ ЖЕ ТОЧКАХ, что
##      ближняя. Стоит начать разбрасывать пучок по ячейке КОЛЬЦА (0.22·k), и
##      смена кольца начнёт двигать каждый пучок — ровно тот дефект, который
##      чинили.
##   3. Все поля жребия живые: вырожденное поле поставило бы весь луг одного
##      роста и под одним углом, пройдя обе проверки выше.
##   4. Эталон жребия. Не ради совпадения с сервером (травы у сервера нет и не
##      будет: у травинки нет тождества, контракт чанков §7), а против молчаливой
##      правки хеша — она пересадила бы весь луг разом, и заметить это можно было
##      бы только сличением снимков.
##   5. Круг вне дерева сцены считается НУЛЁМ пучков. Число, которое смотрят как
##      «нарисовано», не вправе называть нарисованным то, чего в сцене нет.
##   6. Круг ЕДЕТ ЗА КАМЕРОЙ: план перецентрируется, дальнее выбрасывается,
##      корень переезд переживает.
extends "res://tools/check_suite.gd"

## Где стоит камера для пункта 6. Полем, а не местной переменной: замыкание
## GDScript копирует захваченное по значению, и лямбда, отданная в setup, иначе
## навсегда запомнила бы точку старта — то есть проверка проверяла бы сама себя.
var _focus := Vector2.ZERO

## Эталон tuft_lot, снятый с этой реализации 2026-08-12. Сверяется прямым
## равенством с допуском на десятичную запись: поля целочисленного
## происхождения (по 12 бит), и float64 их не портит.
const GOLDEN := [
	[0, 0, 0.8505859375, 0.051513671875, 0.0244140625, 0.893798828125],
	[1, 0, 0.07470703125, 0.236572265625, 0.86328125, 0.01611328125],
	[-1, -1, 0.27001953125, 0.3857421875, 0.84814453125, 0.044921875],
	[123456, -654321, 0.147216796875, 0.569091796875, 0.080810546875, 0.8720703125],
	[7, 9, 0.30908203125, 0.458251953125, 0.974609375, 0.491943359375],
]


func run() -> void:
	# 1. ЖРЕБИЙ — ФУНКЦИЯ ИНДЕКСОВ. Один и тот же адрес считается дважды, а между
	#    вызовами генератор тревожится соседними адресами: заведись внутри хоть
	#    какой-то остаток состояния, второй ответ разошёлся бы с первым.
	var stable := true
	for g_raw in GOLDEN:
		var g: Array = g_raw
		var first := Vegetation.tuft_lot(int(g[0]), int(g[1]))
		for d in 32:
			Vegetation.tuft_lot(int(g[0]) + d, int(g[1]) - d)
			Vegetation.hash01(int(g[0]) - d, int(g[1]) + d, d)
		var again := Vegetation.tuft_lot(int(g[0]), int(g[1]))
		for n in Vegetation.TUFT_LOTS:
			if first[n] != again[n]:
				stable = false
	_ok("жребий пучка не зависит от порядка вызовов", stable,
		"%d адресов, по %d чисел" % [GOLDEN.size(), Vegetation.TUFT_LOTS])

	# 2. СДВИГ НЕ ВЫХОДИТ ЗА ЯЧЕЙКУ. Оба поля сдвига обязаны лежать в [0, 1) —
	#    тогда пучок стоит внутри своей базовой ячейки при ЛЮБОМ шаге кольца.
	#    Отрицательная половина мира проверяется наравне: у арифметического сдвига
	#    вправо там своя беда, и хеш на ней уже вырождался.
	var escaped := 0
	var cells := 0
	# Шаги взяты взаимно простыми и с обеих сторон нуля: сетка адресов, а не
	# сплошной обход — проверка чистая, ей положено идти десятки миллисекунд, а
	# не сотни (замер: сплошные 312 тысяч ячеек стоили 400 мс на 108 проверок).
	for bi in range(-3000, 3000, 53):
		for bj in range(-2000, 2000, 71):
			var lot := Vegetation.tuft_lot(bi, bj)
			cells += 1
			if lot[0] < 0.0 or lot[0] >= 1.0 or lot[1] < 0.0 or lot[1] >= 1.0:
				escaped += 1
	_ok("пучок не выходит за свою базовую ячейку", escaped == 0,
		"проверено %d ячеек, вышли за края %d" % [cells, escaped])

	# 3. ВСЕ ПОЛЯ ЖИВЫЕ. Вырожденное поле (всегда одно и то же число) прошло бы
	#    обе проверки выше и при этом убило бы разнобой: все пучки встали бы
	#    одного роста и под одним углом.
	var lo := PackedFloat32Array()
	var hi := PackedFloat32Array()
	lo.resize(Vegetation.TUFT_LOTS)
	hi.resize(Vegetation.TUFT_LOTS)
	for n in Vegetation.TUFT_LOTS:
		lo[n] = 1.0
		hi[n] = 0.0
	var out_of_range := 0
	for ii in range(0, 400):
		var lot := Vegetation.tuft_lot(ii, ii * 7 - 13)
		for n in Vegetation.TUFT_LOTS:
			var v := float(lot[n])
			if v < 0.0 or v >= 1.0:
				out_of_range += 1
			lo[n] = minf(lo[n], v)
			hi[n] = maxf(hi[n], v)
	var narrow := 0
	for n in Vegetation.TUFT_LOTS:
		if hi[n] - lo[n] < 0.8:
			narrow += 1
	_ok("все поля жребия живые и в [0, 1)", out_of_range == 0 and narrow == 0,
		"вне диапазона %d, вырожденных полей %d из %d" % [
			out_of_range, narrow, Vegetation.TUFT_LOTS])

	# 4. ЭТАЛОН. Четыре первых поля пяти адресов: место пучка и его порода.
	var golden_bad := 0
	for g_raw in GOLDEN:
		var g: Array = g_raw
		var lot := Vegetation.tuft_lot(int(g[0]), int(g[1]))
		for n in 4:
			if absf(float(lot[n]) - float(g[2 + n])) > 1e-9:
				golden_bad += 1
	_ok("жребий совпадает с эталоном", golden_bad == 0,
		"%d полей из %d разошлись" % [golden_bad, GOLDEN.size() * 4])

	# 5. СЧЁТЧИК НЕ ВРЁТ ПРО ОТСОЕДИНЁННЫЙ КРУГ, и эта проверка куплена дефектом,
	#    прожившим двое суток. При выносе поля травы из world.gd (acccf3b) корень
	#    круга уехал в GrassField, а строка, ставившая его в дерево сцены, не
	#    уехала никуда: трава строилась, чанки помечались видимыми, панель называла
	#    118 762 пучка — и в кадре не было НИ ОДНОГО пикселя травы (замер: два
	#    снимка одной сцены, с травой и без неё, 0 различных пикселей из 1 440 000).
	#
	#    Проверяется поэтому не посадка, а ЧЕСТНОСТЬ ЧИСЛА: пока панель готова
	#    называть нарисованным то, чего нет в дереве, следующая такая потеря снова
	#    будет невидимой. Флаг visible у чанка тут ничего не решает — он говорит
	#    лишь «этот уровень выбран среди своих».
	var tree := Engine.get_main_loop() as SceneTree
	var host := Node3D.new()
	tree.root.add_child(host)
	var gf := GrassField.new()
	var st := {}
	gf.stats = st
	gf.ensure_root()
	var chunk_node := Node3D.new()
	var mmi := MultiMeshInstance3D.new()
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = BoxMesh.new()
	mm.instance_count = 7
	mmi.multimesh = mm
	chunk_node.add_child(mmi)
	gf.root.add_child(chunk_node)
	gf.chunks[Vector3i(0, 0, 0)] = chunk_node

	gf.count()
	var detached_says: int = int(st.get("grass_drawn", -1))
	var detached_kept: int = int(st.get("grass_chunks_kept", -1))
	gf.attach(host)
	gf.count()
	var attached_says: int = int(st.get("grass_drawn", -1))

	_ok("круг вне дерева сцены считается нулём пучков",
		detached_says == 0 and detached_kept == 1,
		"панель назвала %d пучков при %d построенном чанке" % [detached_says, detached_kept])
	_ok("поставленный в мир круг считает построенное", attached_says == 7,
		"панель назвала %d пучков, построено 7" % attached_says)

	gf.free_all()
	tree.root.remove_child(host)
	host.queue_free()

	# 6. КРУГ ЕДЕТ ЗА КАМЕРОЙ, А НЕ СТОИТ НА МЕСТЕ СТАРТА.
	#
	#    ЧТО ИМЕННО ЗДЕСЬ ПРОВЕРЯЕТСЯ, И ЧТО НЕТ. Не посадка: покров сюда не
	#    подаётся вовсе, и чанки выходят пустыми. Проверяется ГЕОМЕТРИЯ КРУГА —
	#    что при отъезде камеры план перецентрируется, дальнее выбрасывается, а
	#    корень остаётся в дереве. Посадку внутри ячейки меряют пункты 1–4, а то,
	#    что круг вообще виден, — пункт 5.
	#
	#    Зачем отдельно от них: неподвижный кадр проходит и с кругом, прибитым к
	#    точке старта. Такой круг отъехал бы за спину на первой же сотне метров, а
	#    заметить это можно было бы только поездкой — то есть уже владельцем.
	var rule := await ctx.rule()
	var host2 := Node3D.new()
	tree.root.add_child(host2)
	var gf2 := GrassField.new()
	# Земля НЕ ПУСТА, но и не нулевого уровня: cover_index берёт только уровень 0,
	# поэтому индекс остаётся пуст, и круг строится без единого пучка. Пустой
	# массив тут не годится — plant_all на нём выходит сразу, ничего не построив.
	gf2.setup(rule, [{"level": 1, "cx": 0, "cz": 0}], {},
		func() -> Vector2: return _focus,
		func(_p: Node3D, _n: String, _m: ArrayMesh, _x: Array, _mat: Material,
			_c: PackedColorArray, _s: bool) -> void: return,
		{})
	gf2.attach(host2)

	_focus = Vector2(0.0, 0.0)
	gf2.plant_all()
	var was_keys := gf2.chunks.keys().duplicate()
	var was_focus := gf2.focus

	# Отъезд НА ДИАМЕТР КРУГА с запасом: при 2·GRASS_FAR общего у старого и нового
	# набора не остаётся ничего, и «круг не поехал» отличается от «круг поехал
	# наполовину» без спора о границе.
	_focus = Vector2(3.0 * GrassField.GRASS_FAR, 0.0)
	gf2.plan()
	while gf2.pending() > 0:
		gf2.work(1 << 30)
	gf2.count()

	var moved := gf2.focus.distance_to(was_focus)
	var stayed := 0
	for k in was_keys:
		if gf2.chunks.has(k):
			stayed += 1
	# Ближний к НОВОЙ точке чанк обязан быть построен: без него круг «поехал» лишь
	# в бухгалтерии плана, а под ногами осталась голая земля.
	var here := Vector3i(int(floor(_focus.x / GrassField.GRASS_CHUNK)),
		int(floor(_focus.y / GrassField.GRASS_CHUNK)), 0)
	_ok("фокус круга уехал вместе с камерой", is_equal_approx(moved, 3.0 * GrassField.GRASS_FAR),
		"фокус сдвинулся на %.1f м, камера — на %.1f м" % [moved, 3.0 * GrassField.GRASS_FAR])
	_ok("чанки старого места выброшены", stayed == 0,
		"осталось %d из %d чанков прежнего круга" % [stayed, was_keys.size()])
	_ok("чанк под новой точкой построен", gf2.chunks.has(here),
		"чанк %s, всего построено %d" % [here, gf2.chunks.size()])
	_ok("корень круга остался в дереве после переезда", gf2.root.is_inside_tree(),
		"чанков в круге %d" % gf2.chunks.size())

	gf2.free_all()
	tree.root.remove_child(host2)
	host2.queue_free()
