## ДАЛЬНОСТЬ ВЗГЛЯДА — АРИФМЕТИКА НАСТРОЙКИ И ЕЁ ЭКОНОМИЯ.
##
## Сети здесь делать нечего: правило приходит фикстурой кодом
## (CheckContext.RULE_FIXTURE), а проверяется перевод МЕТРОВ ИГРОКА в УРОВНИ
## СЕРВЕРА — то есть ChunkRule, а не то, что сервер сегодня прислал.
##
## # Что именно доказывается
##
## Главное — не «настройка меняет число», а «уровни выше нужного НЕ СПРАШИВАЮТСЯ
## ВОВСЕ». В этом вся экономия, и выражается она числом адресов: если бы клиент
## спрашивал всё, а лишнее отбрасывал, счёт адресов не изменился бы, картинка
## осталась бы прежней, и разница была бы видна только секундомером.
##
## Рядом доказывается, что ПОТОЛОК СЕРВЕРА НЕ ОБХОДИТСЯ: просьба на 20 км при
## потолке 8192 м даёт 8192 м, а не выдуманные уровни, которых сервер не хранит.
## Что об этом сказано на экране, проверить отсюда нечем — строку показывает мир
## (world.gd, оранжевая строка HUD), и это видно на снимке.
##
## # Правило у каждой проверки СВОЁ, и это не педантизм
##
## view_max_level — поле изменяемое, а ctx.rule() один на весь прогон и общий с
## соседними файлами. Файл, подкрутивший общее правило, менял бы чужие проверки
## молча — ровно тот класс беды, ради которого правило вообще отдаётся фикстурой.
##
## # Цена
##
## ЗАМЕР (2026-08-12): 220 мс на суиту при 132 мс на весь прежний прогон чистых
## проверок. Почти всё это — два отбора адресов над фикстурой сети (взгляд на
## 512 м и на 1024 м), и дешевле не выйдет: экономию видно только в счёте
## отобранных адресов, а отбор адресов и есть работа правила.
extends "res://tools/check_suite.gd"


func run() -> void:
	var ceiling := ChunkRule.from_manifest(CheckContext.RULE_FIXTURE)
	_ok("умолчание — потолок сервера: спрашивается всё, что хранится",
		ceiling.view_max_level == ceiling.max_level and ceiling.view_reach_m() == ceiling.ceiling_reach_m(),
		"%d уровней, %.0f м" % [ceiling.view_max_level + 1, ceiling.view_reach_m()])

	# Просьба игрока — круглые метры, кольца сервера — 512·2^k. Между ними
	# ОКРУГЛЕНИЕ ВВЕРХ: «видеть не ближе чем», иначе настройка врала бы в свою
	# пользу, отдавая мир ближе запрошенного.
	var near := _view(500.0)
	_ok("500 м — один уровень", int(near["levels"]) == 1)
	_ok("500 м — видно на 512 м (кольцо целиком, вверх до кольца)",
		float(near["reach_m"]) == 512.0)
	_ok("500 м — потолок не задет", not bool(near["capped"]))

	# Граница кольца принадлежит своему кольцу — так же, как у level_for и у
	# сервера (chunk.LevelFor).
	_ok("ровно 512 м — по-прежнему один уровень", int(_view(512.0)["levels"]) == 1)
	_ok("512 м с эпсилоном — уже два", int(_view(512.001)["levels"]) == 2)

	var mid := _view(2000.0)
	_ok("2000 м — три уровня", int(mid["levels"]) == 3)
	_ok("2000 м — видно на 2048 м", float(mid["reach_m"]) == 2048.0)

	var all := _view(ChunkRule.REACH_ALL)
	_ok("«сколько есть» — все уровни манифеста", int(all["levels"]) == 5)
	_ok("«сколько есть» — потолком не считается урезанным", not bool(all["capped"]),
		"даль называет манифест, а не клиент")

	# ПОТОЛОК НЕ ОБХОДИТСЯ. Просьба сверх засеянного не порождает ни одного
	# уровня, которого сервер не хранит, — она упирается в потолок и говорит об
	# этом флагом.
	var over := _view(20000.0)
	_ok("20 км при потолке 8192 м — потолок объявлен недобранным", bool(over["capped"]))
	_ok("20 км — видно ровно потолок", float(over["reach_m"]) == 8192.0)
	_ok("20 км — уровней не больше, чем хранит сервер", int(over["levels"]) == 5)

	# ДВА РАЗНЫХ ВОПРОСА, И ОТВЕТЫ РАЗНЫЕ. level_for отвечает за сервер («докуда
	# мир хранится»), view_level_for — за этот клиент («докуда он смотрит»).
	var short := ChunkRule.from_manifest(CheckContext.RULE_FIXTURE)
	short.set_view_reach(1000.0)
	_ok("за взглядом сервер уровень всё ещё называет", short.level_for(3000.0) == 3)
	_ok("за взглядом клиент земли не рисует", short.view_level_for(3000.0) == -1)
	_ok("внутри взгляда оба отвечают одинаково",
		short.view_level_for(700.0) == short.level_for(700.0))

	await _check_economy()


## _check_economy — СЧЁТ АДРЕСОВ, а не рассуждение об экономии.
##
## Отбирается ровно то, что отбирает мир (world.gd::_load_terrain). Разница со
## взглядом на 512 м — в том, что уровня 1 в списке НЕТ ВОВСЕ, а не в том, что
## он приезжает и выбрасывается.
##
## «Чанка нет» здесь не бывает: это отбор, а не загрузка. Событие сети живёт в
## checks/live.
func _check_economy() -> void:
	var axis := await ctx.axis()
	var bbox := await ctx.bbox()

	var by_level_512 := _addresses(500.0, axis, bbox)
	var by_level_1024 := _addresses(1000.0, axis, bbox)
	var n512 := _total(by_level_512)
	var n1024 := _total(by_level_1024)

	_ok("взгляд на 512 м: уровня 1 не спрашивают ВОВСЕ",
		not by_level_512.has(1), str(by_level_512))
	_ok("взгляд на 1024 м: уровень 1 появился", int(by_level_1024.get(1, 0)) > 0,
		str(by_level_1024))
	_ok("ближний взгляд стоит меньше адресов", n512 < n1024,
		"%d против %d" % [n512, n1024])


## _addresses — адреса, которые клиент спросил бы при этой дальности, по уровням.
func _addresses(reach_m: float, axis: PackedVector2Array, bbox: Rect2) -> Dictionary:
	var rule := ChunkRule.from_manifest(CheckContext.RULE_FIXTURE)
	rule.set_view_reach(reach_m)
	var by_level := {}
	for level in range(0, rule.view_max_level + 1):
		var cells: Array = rule.cells_for_level(axis, bbox, level)
		if not cells.is_empty():
			by_level[level] = cells.size()
	return by_level


func _total(by_level: Dictionary) -> int:
	var n := 0
	for k in by_level:
		n += int(by_level[k])
	return n


## _view — что вышло из просьбы. Правило своё на каждый вызов: настройка
## назначается один раз и меняет отбор, а не пересчитывается на ходу.
func _view(reach_m: float) -> Dictionary:
	return ChunkRule.from_manifest(CheckContext.RULE_FIXTURE).set_view_reach(reach_m)
