## РАЗБОР ВСЕГО КОДА КЛИЕНТА. Проверка не про мир, а про то, что остальные
## проверки не лгут.
##
## ПОВОД (ClearAhead-9u9, 2026-08-12): в track_view.gd лежала ошибка РАЗБОРА, а
## не логики — нетипизированный литерал массива, из-за которого GDScript
## отказывался разбирать файл целиком. `make dev-check` дал при этом 78 проверок
## и НОЛЬ отказов, а пустой кадр поймал снимок. Повторено замером 2026-08-14 на
## выросшей суите: та же ошибка, 199 проверок, ноль отказов.
##
## ПРИЧИНА МОЛЧАНИЯ ОБЩАЯ, а не про один файл: суита компилирует ровно то, на
## что ссылается сама. Рисующий код в цепочку зависимостей проверок не входил
## вовсе — значит его никто и не разбирал. Поэтому лечение тоже общее: здесь
## грузится КАЖДЫЙ .gd клиента, а не тот, о котором вспомнили. Список файлов не
## перечислен нигде по той же причине, по какой не перечислены сами проверки
## (шапка check.gd): перечень стареет молча.
##
## ПРИЗНАК НЕГОДНОСТИ — can_instantiate(), И ЭТО ЗАМЕР, А НЕ ДОГАДКА.
##
## Первая редакция этой проверки ждала от load() ответа null и не поймала
## подложенную ошибку разбора вовсе: движок пишет в лог `Failed to load script …
## with error "Parse error"`, но load() ВОЗВРАЩАЕТ ОБЪЕКТ GDScript — негодный.
## CACHE_MODE_IGNORE даёт тот же объект. Что различает годный и негодный
## (замер 2026-08-14, Godot 4.7.1, 58 файлов клиента):
##
##   can_instantiate()  — true у всех 58 здоровых, false у неразбираемого;
##   reload()           — OK у здоровых, 43 (ERR_PARSE_ERROR) у битого, НО 22 у
##                        того файла, который сейчас исполняется. Отвергнут:
##                        проверка обязана краснеть на чужой ошибке, а не на
##                        факте собственного запуска.
##
## Цена can_instantiate() названа: скрипт, объявленный абстрактным, тоже даст
## false. Таких в клиенте нет; появится — здесь будет отказ, и это лучше, чем
## тихое «разобралось».
##
## ЧЕГО ПРОВЕРКА НЕ ДЕЛАЕТ, и это сказано вслух: она не зовёт ни одной функции.
## Файл, который разбирается и падает при первом вызове, для неё зелёный. За это
## отвечают проверки, гоняющие сам код, — 45_track_view.gd и соседи. Сцены
## (*.tscn) сюда тоже не входят: битый скрипт в сцене ловится этим же обходом, а
## отсутствующий — нет, и делать вид, что ловится, хуже, чем не ловить.
extends "res://tools/check_suite.gd"

## Корни обхода. tools лежит здесь рядом с scripts нарочно: пробники
## (walk_probe, stock_probe, fixture_pull) — такой же код клиента, и их не
## разбирает вообще никто, пока их не запустят руками.
const ROOTS := ["res://scripts", "res://tools"]


func run() -> void:
	var files: Array[String] = []
	for r in ROOTS:
		var found := _gd_files(r)
		# Пустой корень — сбой устройства, а не «нечего проверять»: так же, как
		# пустой каталог проверок у бегуна. Опечатка в пути обесценила бы всю
		# суиту, оставив её зелёной.
		if found.is_empty():
			ctx.report.infra("%s: ни одного .gd" % r)
			continue
		files.append_array(found)
	files.sort()

	var broken: Array[String] = []
	for p in files:
		var res := load(p)
		var scr := res as Script
		var why := ""
		if res == null:
			why = "файл не загрузился вовсе"
		elif scr == null:
			why = "загрузилось не скриптом"
		elif not scr.can_instantiate():
			why = "разбор не прошёл"
		if why != "":
			broken.append(p)
			_ok("разбор: %s" % p, false, why)
	_ok("каждый скрипт клиента разбирается", broken.is_empty(),
		"файлов %d, не разобрано %d" % [files.size(), broken.size()])


## _gd_files — все *.gd под каталогом, включая подкаталоги.
##
## Рекурсия нужна не для красоты: проверки лежат в tools/checks/pure и
## tools/checks/live, и плоский обход прошёл бы мимо двух третей кода оснастки.
func _gd_files(dir_path: String) -> Array[String]:
	var out: Array[String] = []
	var dir := DirAccess.open(dir_path)
	if dir == null:
		return out
	for file_name in dir.get_files():
		if file_name.ends_with(".gd"):
			out.append("%s/%s" % [dir_path, file_name])
	for sub in dir.get_directories():
		out.append_array(_gd_files("%s/%s" % [dir_path, sub]))
	return out
