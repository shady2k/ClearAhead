## ГРАНИЦА ТРАНСПОРТА — чистая проверка: она про ИСХОДНИКИ, а не про сервер.
##
## Смотрит на ВЕСЬ client/scripts/ и обязана смотреть дальше: слой (world_api.gd)
## заведён 2026-08-12 затем, чтобы адреса, коды и имена заголовков жили в одном
## месте, и единственный способ заметить их возвращение — глядеть на текст.
extends "res://tools/check_suite.gd"

## Файлы транспортного слоя. Всё остальное в client/scripts/ — игра и рендер, и
## им про провод знать нечем.
##
## С 2026-08-14 их четыре, а не два: у клиента появился ВТОРОЙ ТРАНСПОРТ —
## сокет канала команд (ClearAhead-wa51). Деление внутри него то же, что было у
## первого, и не случайно: net_channel.gd — механика (кадры, соединение,
## корреляция ответа), live_channel.gd — смысл (версия конверта, рукопожатие,
## сессия, снапшот, причины отказа). Пара NetClient/WorldApi доказала, что
## граница проходит именно здесь, и второй транспорт повторяет её, а не
## изобретает свою.
const TRANSPORT_FILES := ["net_client.gd", "world_api.gd", "net_channel.gd", "live_channel.gd"]

## Имена труб. Назвал трубу вне слоя — значит достал до провода мимо слоя.
##
## Их тоже две, и вторая добавлена вместе с сокетом: правило «рендер не знает
## транспорта» не имеет смысла, если сторожит только один из них.
const PIPE_NAMES := ["NetClient", "NetChannel"]

## Коды, которыми говорит HTTP. Список закрытый нарочно: «любое трёхзначное
## число» ловило бы азимут камеры 205°, дальность тени 900 м и полуширину панели
## 700 пикселей — то есть проверка кричала бы на рисунок вместо протокола.
const HTTP_CODES := ["200", "201", "204", "206", "301", "302", "304",
	"400", "401", "403", "404", "500", "502", "503"]


## ДОКАЗАТЕЛЬСТВО ГРЕПОМ, что связанность ушла.
##
## # Почему текстом, а не рассуждением
##
## Все прочие проверки клиента проверяют ПОВЕДЕНИЕ; здесь проверяется ФОРМА
## исходника, и это тот редкий случай, где грубый поиск по тексту честнее любого
## умного довода. Граница «рендер не знает протокола» не выражается ни одним
## наблюдаемым числом: клиент, у которого коды снова расползлись по world.gd,
## рисует ровно ту же картинку и проходит все остальные проверки до единой.
## Заметить возврат можно только глядя на текст — и лучше это делать раз в
## прогон, чем через год на разборе.
##
## ЗАМЕР, ради которого проверка написана (ClearAhead-w6d, 2026-08-12, до
## правки): шесть шаблонов адреса вне трубы, пять мест решения по коду, имя
## заголовка в двух файлах.
##
## # Что считается и чего не считается
##
## Полнострочные комментарии пропускаются. Комментарий, поминающий 204, ничего не
## связывает — он рассказывает историю; строка кода, ветвящаяся по 204, и есть
## связанность. Зато строки со СТРОКАМИ считаются наравне с кодом, и это тоже
## решение: HUD, объясняющий игроку коды HTTP, — такое же знание протокола в
## рендере, только высказанное вслух.
##
## Каталог res://tools/ проверкой НЕ ПРОСМАТРИВАЕТСЯ, и это не забывчивость:
## оснастка проверок для того и живёт вне игры, чтобы щупать провод нарочно.
##
## # Проверка проверки
##
## Последним пунктом считается число кодов В САМОМ СЛОЕ. Ноль там означал бы, что
## сломан не клиент, а выражение, — и тогда все четыре предыдущих пункта зелены
## по той же причине, по которой зелена выключенная лампочка.
func run() -> void:
	var codes := RegEx.new()
	var err := codes.compile("(?<![0-9.])(" + "|".join(HTTP_CODES) + ")(?![0-9.])")
	# Шаблон адреса — строковый литерал, начинающийся с косой черты И ИМЕНИ:
	# "/regions/%s". Одна голая черта в литерале адресом не является и в клиенте
	# встречается дважды — rstrip("/") у адреса сервера в app.gd и world.gd.
	var addr := RegEx.new()
	err = err | addr.compile("\"/[A-Za-z%]")
	_ok("выражения границы собраны", err == OK)
	if err != OK:
		return

	var dir := DirAccess.open("res://scripts")
	if dir == null:
		_ok("исходники клиента читаются", false, "res://scripts не открылся")
		return

	var addresses: Array[String] = []
	var numbers: Array[String] = []
	var headers: Array[String] = []
	var pipes: Array[String] = []
	var scanned := 0
	var codes_in_layer := 0

	for file_name in dir.get_files():
		if not file_name.ends_with(".gd"):
			continue
		var text := FileAccess.get_file_as_string("res://scripts/" + file_name)
		if file_name in TRANSPORT_FILES:
			codes_in_layer += codes.search_all(text).size()
			continue
		scanned += 1
		# Имя заголовка ищется во ВСЁМ тексте, включая комментарии: это точное имя
		# из протокола, и в прозе оно не появляется случайно — только пересказом
		# договора там, где договор знать не положено.
		if text.contains("X-Chunk") or text.contains(WorldApi.HEADER_BASE_Z):
			headers.append(file_name)
		# Имя трубы — то же самое, но структурно: назвал трубу — значит достал
		# до провода мимо слоя.
		for pipe_name in PIPE_NAMES:
			if text.contains(pipe_name):
				pipes.append("%s (%s)" % [file_name, pipe_name])
		var line_no := 0
		for line in text.split("\n"):
			line_no += 1
			var code_line := line.strip_edges()
			if code_line.begins_with("#"):
				continue
			if addr.search(code_line) != null:
				addresses.append("%s:%d" % [file_name, line_no])
			if codes.search(code_line) != null:
				numbers.append("%s:%d" % [file_name, line_no])

	_ok("исходники рендера просмотрены", scanned > 0, "%d файлов" % scanned)
	_ok("вне транспортного слоя нет ни одного шаблона адреса", addresses.is_empty(), str(addresses))
	_ok("вне транспортного слоя нет ни одного кода HTTP", numbers.is_empty(), str(numbers))
	_ok("вне транспортного слоя нет имени заголовка", headers.is_empty(), str(headers))
	_ok("вне транспортного слоя не названа ни одна труба", pipes.is_empty(), str(pipes))
	_ok("проверка не пустая: в самом слое коды найдены", codes_in_layer > 0,
		"%d вхождений в %s" % [codes_in_layer, str(TRANSPORT_FILES)])
