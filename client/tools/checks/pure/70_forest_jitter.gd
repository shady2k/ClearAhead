## ЭТАЛОН ФУНКЦИИ АДРЕСА ЛЕСА.
##
## Здесь впервые с 4b4d6a7 в проекте снова есть ЭТАЛОН — и он возможен ровно
## потому, что ForestJitter ЦЕЛОЧИСЛЕННАЯ. Прежний эталон контракта сверял
## вычисленные float64 байт в байт, не пережил смены машины (расхождение ~1e-13
## при неизменном коде) и был снесён. Целочисленный хеш этому не подвержен: он
## совпадает точно, и сверять его прямым равенством законно.
##
## Значения сняты с сервера (go test ./internal/chunk -run Jitter). Расхождение
## здесь означает, что два рендерера поставят деревья разной высоты в разные
## места одной ячейки. Сети проверке не нужно и не было нужно никогда — эталон и
## есть фикстура, снятая один раз.
extends "res://tools/check_suite.gd"

const GOLDEN := [
	[0, 0, 0, 0, 0.997021957999, 0.975669407053, 0.305195895955],
	[0, 0, 1, 0, 0.510754926130, 0.311136816163, 0.079881879967],
	[0, 0, 63, 63, 0.354992379900, 0.613074719207, 0.170557471691],
	[-3, 7, 12, 34, 0.310825415654, 0.206842476968, 0.294738489669],
	[1000, -1000, 5, 9, 0.517305331072, 0.371780550340, 0.267461374868],
]


func run() -> void:
	var jit_bad := 0
	for g_raw in GOLDEN:
		var g: Array = g_raw
		var got := Forest.jitter(int(g[0]), int(g[1]), int(g[2]), int(g[3]))
		# Допуск 1e-12, а не 1e-9: величина целочисленного происхождения, и
		# сверять её можно почти точно. Остаток — только на десятичную запись
		# эталона в исходнике, а не на арифметику.
		if absf(got[0] - float(g[4])) > 1e-12 or absf(got[1] - float(g[5])) > 1e-12 or absf(got[2] - float(g[6])) > 1e-12:
			jit_bad += 1
	_ok("ForestJitter совпадает с эталоном сервера", jit_bad == 0,
		"%d из %d адресов разошлись" % [jit_bad, GOLDEN.size()])
