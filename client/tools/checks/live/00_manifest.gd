## МАНИФЕСТ — пролог всего сетевого прогона: без правила подробности клиент не
## знает, что спрашивать. Стоит первым по имени файла нарочно (порядок = имя),
## и если манифеста нет, бегун прекращает сетевую половину: полсотни отказов
## подряд сказали бы одно и то же.
##
## ИМЕНА ПОЛЕЙ проверяются здесь же, и это главный довод, почему суита сетевая, а
## не чистая. Она заведена после того, как клиент читал `network.trackside` (поле
## переименовано в `structures` коммитом 3637504) и `track_hash` (умер вместе с
## ресурсом geometry). Ни то, ни другое не падало: get(имя, умолчание) на
## пропавшем поле молча даёт умолчание, и HUD показывал ноль вместо единицы.
## Отставшее имя обязано быть отказом здесь, а не наблюдением на снимке — и
## спрашивать о нём надо ЖИВОЙ сервер, потому что снимок ответа стареет вместе
## с клиентом и согласится с ним в любой ошибке.
extends "res://tools/check_suite.gd"


func run() -> void:
	var man_res := await ctx.manifest_answer()
	_ok("манифест получен", not man_res.failed(), man_res.reason)
	if man_res.failed():
		return
	var man := await ctx.manifest()
	var rule := await ctx.rule()
	_ok("правило подробности заполнено", rule.valid(), rule.rule_text())

	for f in ["region", "epoch", "revision", "network_model_hash", "network_hash", "chunks"]:
		_ok("манифест несёт поле %s" % f, man.has(f))

	# Шаг выборки оси — из манифеста, а не 5.0 числом у клиента: своя копия
	# означала бы другое правило подробности при том же манифесте
	# (ClearAhead-cg3). Проверяется, что сервер его вообще назвал.
	_ok("манифест назвал шаг выборки оси", rule.axis_step_m > 0.0,
		"axis_step_m = %.2f м" % rule.axis_step_m)
