	[15, 0.075, 0.44, 0.06, 0.15, 1.55, 3],   # низкая широкая кочка
	[11, 0.020, 0.08, 0.28, 0.62, 0.75, 2],   # метёлка: выше всех, но реже
]
const GRASS_QUAD_W := 0.16       # м — ширина квада у эталонного пучка
const GRASS_MESH_H := 1.0        # м — высота эталонного пучка

## Палитра пучка: три тона зелени плюс ветошь.
##
## ТЁМНЫЙ КОНЕЦ ПАЛИТРЫ ПОДНЯТ, И ЭТО НЕ ВКУСОВЩИНА — довод спайка, перенесённый
## вместе с числами. Сверху вертикальный квад виден почти с ребра: его площадь в
## плане — доли сантиметра, а по экрану он размазывается в короткий штрих. Штрих,
## который темнее земли втрое, глаз читает не травой, а МУСОРОМ — сухими ветками
## по лугу. Втрое набиралось перемножением независимых затемнений: тёмный тон
## палитры, сухость, жребий яркости, тень у корня в вершинном цвете и нижний
## конец карты листа. Каждое по отдельности разумно, вместе — уголь.
const C_GRASS_LUSH := Color(0.40, 0.55, 0.22)
const C_GRASS_DARK := Color(0.32, 0.45, 0.20)
const C_GRASS_PALE := Color(0.50, 0.58, 0.26)
const C_GRASS_WITHER := Color(0.64, 0.56, 0.30)


## hash01 — ЖРЕБИЙ ПО ЯЧЕЙКЕ МИРОВОЙ СЕТКИ. Одна и та же тройка (i, j, соль)
## всегда даёт одно и то же число, на любой машине и в любом порядке вызовов.
##
## # Почему это НЕ второй ответ на вопрос «где растёт трава»
##
## Здесь до 2026-08-12 стояла пометка «жребий ТЕКСТУРЫ, и только её», а место
## пучка считал Forest.jitter — хеш, который есть и у сервера. Пометка снята
## вместе с той посадкой, и вот почему это не откат к самоуправству клиента.
##
## Сервер отвечает на вопрос ЕСТЬ ЛИ ЗДЕСЬ ТРАВА И СКОЛЬКО ЕЁ: класс покрова и
## сомкнутость приезжают ячейкой 4 м и остаются единственным входом в посадку.
## Внутри ячейки решается только «куда встал пучок в пределах 22 см и как он
## повёрнут» — у травинки нет тождества (контракт чанков §7), её нельзя срубить,
## посадить и передать, и второй рендерер вправе расставить эти 22 сантиметра
## иначе, не изменив мира ни на байт. Forest.jitter же обязан совпадать с
## сервером, потому что дерево СРУБИТЬ можно, и адресуется он индексами ВНУТРИ
## чанка — на глобальной сетке 0.22 м его `j * 64 + i` вырождается.
##
## Маски держим положительными: у арифметического сдвига вправо отрицательное
## остаётся отрицательным, и хеш вырождается в пилу на всей отрицательной
## половине мира.
static func hash01(i: int, j: int, salt: int) -> float:
	var h: int = (i * 73856093) ^ (j * 19349663) ^ (salt * 83492791)
	h &= 0x7FFFFFFF
	h = ((h ^ (h >> 15)) * 2246822519) & 0x7FFFFFFF
	h = ((h ^ (h >> 13)) * 3266489917) & 0x7FFFFFFF
	h ^= h >> 16
	return float(h & 0xFFFFFF) / 16777216.0


## КУРТИННОСТЬ — ОТДЕЛЬНЫЙ ШУМ, И БЕЗ НЕЁ ТРАВА ЧИТАЕТСЯ РОВНЫМ ВОРСОМ.
##
## Порт `_n_tuft` из снесённого спайка вместе с доводом. Крупная маска покрова
## отвечает, есть ли здесь трава ВООБЩЕ (у нас это присланная сомкнутость); эта —
## насколько она густа и высока ВНУТРИ одной дернины. Период ~11 м: пучки
## собираются в связные куртины размером с двор, между куртинами трава редеет и
## приземляется.
##
## Здесь до 2026-08-12 (вечер) вероятность посадки равнялась просто
## `closure / 15`, независимо в каждой ячейке 22 см. Независимый жребий по
## однородной вероятности и есть определение равномерного ворса: у него нет
## масштаба крупнее ячейки, а глаз читает именно масштабы. Спайк записал ту же
## находку про ВЫСОТУ: «жребий по всему полю даёт ровный ворс средней высоты —
## глаз читает его ковром».
##
## Это РИСУНОК РАССЕВА, а не факт о мире, и потому шум клиентский навсегда:
## сомкнутость 11/15 сервер прислал, а разложить её в куртины по 11 м или в
## ровный ворс — вопрос кадра. У травинки тождества нет (контракт чанков §7).
const TUFT_M := 11.0             # м — характерный размер куртины
static var _n_tuft: FastNoiseLite = null

## tuft — густота куртины в точке, 0…1. Ноль — прогалина внутри дернины, единица
## — самая гуща.
static func tuft(x: float, y: float) -> float:
	if _n_tuft == null:
		_n_tuft = FastNoiseLite.new()
		_n_tuft.seed = 0x7A17
		# Частота спайка 0.09 — это период около 11 м. Две октавы: третья дала бы
		# рябь мельче ячейки посадки, то есть снова шум вместо рисунка.
		_n_tuft.frequency = 1.0 / TUFT_M
		_n_tuft.fractal_octaves = 2
	return 0.5 + 0.5 * _n_tuft.get_noise_2d(x, y)


## ЗАРОСЛИ КУСТОВ — ТОЖЕ КУРТИНАМИ, И ТОЖЕ ШУМОМ. Порт `_n_bush` из спайка.
##
## Довод его записан рядом с посадкой: «заросли берутся КРУПНЫМ шумом В
## КВАДРАТЕ; квадрат давит середину, поэтому куртина получается плотной, а между
## куртинами кустов нет вовсе. Равномерный жребий по полю дал бы соль с перцем —
## ровно то, чего в натуре не бывает».
##
## Зачем кусты вообще: «на среднем плане они и есть та деталь, которой не
## хватало — с двухсот метров трава уже не читается (её пучок мельче пикселя), а
## куст ещё читается, и открытый луг перестаёт быть заливкой между лесом и
## путём».
const BUSH_CLUMP_M := 77.0       # м — размер заросли
static var _n_bush: FastNoiseLite = null

## bush_clump — густота заросли в точке, 0…1.
static func bush_clump(x: float, y: float) -> float:
	if _n_bush == null:
		_n_bush = FastNoiseLite.new()
		_n_bush.seed = 0xB05
		_n_bush.frequency = 1.0 / BUSH_CLUMP_M
		_n_bush.fractal_octaves = 2
	return clampf(0.5 + 0.5 * _n_bush.get_noise_2d(x, y), 0.0, 1.0)


## Сколько чисел жребия отдаёт tuft_lot. Порядок полей назван словами рядом с
## разбором пучка (_grass_cell в world.gd) — здесь только их количество.
const TUFT_LOTS := 12

## tuft_lot — ВЕСЬ жребий одного пучка ОДНИМ вызовом, а не двенадцатью.
##
## Ради скорости, и это замер, а не вкус: посадка обходит сотни тысяч ячеек
## мировой сетки за пересадку, а статический вызов в GDScript стоит около
## полумикросекунды сам по себе. Двенадцать hash01 на пучок — это порядка пяти
## микросекунд только на вызовы, то есть больше секунды на круг, при том что вся
## остальная работа над пучком укладывается в три-четыре.
##
## Числа берутся ПОЛЯМИ ОДНОЙ цепочки перемешивания, по 12 бит на поле: 1/4096
## — это доли миллиметра на ячейке 22 см и сотые градуса на повороте, то есть
## запас против всего, что этими числами решается. Соседние поля независимы
## ровно настолько, насколько независимы соседние биты splitmix-подобного
## перемешивания, — а на это и рассчитано.
static func tuft_lot(i: int, j: int) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	out.resize(TUFT_LOTS)
	var h: int = (i * 73856093) ^ (j * 19349663) ^ 83492791
	var n := 0
	while n < TUFT_LOTS:
		h &= 0x7FFFFFFF
		h = ((h ^ (h >> 15)) * 2246822519) & 0x7FFFFFFF
		h = ((h ^ (h >> 13)) * 3266489917) & 0x7FFFFFFF
		h ^= h >> 16
		out[n] = float(h & 0xFFF) / 4096.0
		if n + 1 < TUFT_LOTS:
			out[n + 1] = float((h >> 12) & 0xFFF) / 4096.0
		n += 2
	return out


## grass_mesh — пучок: несколько КРЕСТ-НАКРЕСТ поставленных текстурных квадов.
##
## НОРМАЛЬ У ВСЕХ ВВЕРХ, а не поперёк листа: тогда пучок освещается как земля, из
## которой растёт, и трава не распадается на чёрные и белые лоскуты при повороте
## камеры. Приём стандартный для стилизованной травы, и стоит ноль.
##
## Квад слегка ЗАВАЛЕН вершиной в сторону: вертикальный крест читается плоским
## значком, наклонённый — растением.
static func grass_mesh(spec: Array) -> ArrayMesh:
	var quads := int(spec[6])
	var lean_k := float(spec[2]) * 0.5
	var v := PackedVector3Array()
	var n := PackedVector3Array()
	var c := PackedColorArray()
	var uv := PackedVector2Array()
	var idx := PackedInt32Array()
	# Тень у корня рисует САМА карта листа (там значение падает к 0.42), и второй
	# раз её класть вершинным цветом нельзя: два затемнения на одну величину и
	# давали чёрный штрих сверху. Здесь остаётся только просветление кончика.
	var base := Color(1.0, 1.0, 1.0)
	var tip := Color(1.05, 1.05, 1.05)
	for k in quads:
		var a := PI * float(k) / float(quads)
		var d := Vector3(cos(a), 0.0, sin(a)) * (GRASS_QUAD_W * 0.5)
		var lean := Vector3(cos(a + 1.9), 0.0, sin(a + 1.9)) * (GRASS_MESH_H * lean_k)
		var top := Vector3(0.0, GRASS_MESH_H, 0.0) + lean
		var b := v.size()
		v.append(-d); v.append(d); v.append(top + d); v.append(top - d)
		# UV: v=1 у корня, v=0 у верхушки — так же лежит и тайл (кончики вверху),
		# и на этом же v держится размах ветра в шейдере.
		uv.append(Vector2(0.0, 1.0)); uv.append(Vector2(1.0, 1.0))
		uv.append(Vector2(1.0, 0.0)); uv.append(Vector2(0.0, 0.0))
		for _i in 4:
			n.append(Vector3.UP)
		var lb := base.srgb_to_linear()
		var lt := tip.srgb_to_linear()
		c.append(lb); c.append(lb); c.append(lt); c.append(lt)
		idx.append_array([b, b + 1, b + 2, b, b + 2, b + 3])
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = v
	arrays[Mesh.ARRAY_NORMAL] = n
	arrays[Mesh.ARRAY_COLOR] = c
	arrays[Mesh.ARRAY_TEX_UV] = uv
	arrays[Mesh.ARRAY_INDEX] = idx
	var m := ArrayMesh.new()
	m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return m


## _grass_image — тайл пучка: листья РИСУЮТСЯ, а не берутся с диска.
##
## Лист — мазок от корня к кончику: центр уходит вбок по квадратичной кривой (у
## травы изгиб растёт к верхушке, а не идёт прямой наклонной), ширина сходит на
## нет, тон светлеет.
##
## АЛЬФА БИНАРНАЯ, и вырез делает материал (alpha scissor). Полупрозрачность
## здесь брать нельзя: пучков десятки тысяч, они входят друг в друга, и любая
## сортировка по глубине на них разваливается.
static func _grass_image(spec: Array, salt: int) -> Image:
	var n := int(spec[0])
	var bw := float(spec[1])
	var bend := float(spec[2])
	var img := Image.create_empty(GRASS_TEX, GRASS_TEX, false, Image.FORMAT_RGBA8)
	# ФОН ЗАЛИТ СРЕДНИМ ТОНОМ ЛИСТА, А НЕ ЧЁРНЫМ, хотя он и прозрачен. Мип
	# усредняет ВСЕ каналы, включая цвет невидимых пикселей: при чёрном фоне трава
	# на средней дистанции темнела вдвое и читалась бурой щёткой на светлом лугу.
	# Прозрачность гасит пиксель, но не исключает его из усреднения.
	img.fill(Color(0.62, 0.62, 0.62, 0.0))
	for b in n:
		var x0 := (0.08 + 0.84 * hash01(b, salt, 21)) * GRASS_TEX
		var hb := (0.52 + 0.48 * hash01(b, salt, 22)) * GRASS_TEX
		var side := 1.0 if hash01(b, salt, 23) > 0.5 else -1.0
		var curve := side * bend * GRASS_TEX * (0.4 + 1.2 * hash01(b, salt, 24))
		var w0 := bw * GRASS_TEX * (0.7 + 0.7 * hash01(b, salt, 25))
		var tint := 0.68 + 0.32 * hash01(b, salt, 26)
		var steps := int(hb) * 2
		for s in steps + 1:
			var t := float(s) / float(steps)      # 0 у корня, 1 у кончика
			var py := int(GRASS_TEX - 1 - t * hb)
			if py < 0 or py >= GRASS_TEX:
				continue
			var cxp := x0 + curve * t * t
			var hw := w0 * (1.0 - t * t) * 0.5 + 0.35
			# Значение — НЕ ЦВЕТ, а множитель яркости листа: 0 у корня в тени,
			# 1 на освещённом кончике. Цвет пучка приходит цветом экземпляра.
			var val: float = clampf(tint * lerpf(0.42, 1.0, t), 0.0, 1.0)
			var col := Color(val, val, val, 1.0)
			for px in range(int(floor(cxp - hw)), int(ceil(cxp + hw)) + 1):
				if px >= 0 and px < GRASS_TEX:
					img.set_pixel(px, py, col)
	img.generate_mipmaps()
	return img


## ВЕТЕР КАЧАЕТ ВЕРХУШКУ, А НЕ ПУЧОК ЦЕЛИКОМ: размах растёт как квадрат высоты по
## UV, у корня он ноль — иначе трава ездит по земле, как приклеенная картинка.
##
## ЧЕСТНОЕ ОГРАНИЧЕНИЕ, перенесённое вместе с кодом: сдвиг считается в МЕСТНЫХ
## осях пучка, а поворот вокруг вертикали у каждого пучка свой — значит единого
## направления ветра нет, каждый качается по-своему. Фаза при этом взята от
## МИРОВОГО положения, поэтому порыв всё равно бежит по лугу волной, и на глаз
## это читается ветром. Правильное лечение — переводить мировое направление в
## местные оси, но это inverse матрицы на вершину при десятках тысяч пучков.
const GRASS_SHADER := """
shader_type spatial;
render_mode cull_disabled, depth_prepass_alpha, diffuse_burley;

// БЕЗ source_color, И ЭТО НЕ МЕЛОЧЬ. Первый заход спайка объявил тайл цветом —
// движок перевёл его из sRGB в линейное, а цвет экземпляра УЖЕ линейный, и трава
// вышла чёрной щёткой: два перевода подряд на одну величину. Тайл здесь не цвет,
// а карта яркости листа, поэтому берётся сырым и раскладывается в множитель
// вокруг единицы.
uniform sampler2D blade : filter_linear_mipmap, repeat_disable;
uniform float shade_lo;          // во что превращается 0 карты листа
uniform float shade_hi;          // и во что — 1
uniform float wind_speed;
uniform float wind_amp;          // доли высоты пучка — размах верхушки
uniform float wind_len;          // м — длина волны порыва по лугу
uniform float cutoff;            // порог альфа-выреза

void vertex() {
	float up = 1.0 - UV.y;               // 0 у корня, 1 у верхушки
	vec3 w = MODEL_MATRIX[3].xyz;
	float ph = TIME * wind_speed + (w.x + w.z * 0.6) / wind_len;
	float s = (sin(ph) + 0.45 * sin(ph * 2.7 + 1.3)) * wind_amp * up * up;
	VERTEX.x += s;
	VERTEX.y -= abs(s) * 0.25;           // верхушка при наклоне ОПУСКАЕТСЯ
}

void fragment() {
	// НОРМАЛЬ ВОЗВРАЩАЕТСЯ ВВЕРХ. Меш кладёт её вверх нарочно (см. grass_mesh),
	// но render_mode cull_disabled включает в шаблоне Godot проверку стороны: на
	// изнанке грани движок сам ставит NORMAL = -NORMAL. То есть у КАЖДОГО квада
	// одна сторона получала нормаль ВНИЗ и освещалась солнцем в спину.
	//
	// Это и была «убогая трава» у спайка, и найдено оно замером, а не глазом:
	// подмена альбедо на плоскую заливку дала половину пучков яркими, половину
	// почти чёрными при ОДНОМ И ТОМ ЖЕ цвете.
	if (!FRONT_FACING) {
		NORMAL = -NORMAL;
	}
	vec4 t = texture(blade, UV);
	ALBEDO = COLOR.rgb * (shade_lo + (shade_hi - shade_lo) * t.r);
	ALPHA = t.a;
	ALPHA_SCISSOR_THRESHOLD = cutoff;
	ROUGHNESS = 0.94;
	SPECULAR = 0.1;
}
"""


static func grass_material(spec: Array, kind: int) -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = GRASS_SHADER
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("blade", ImageTexture.create_from_image(_grass_image(spec, kind)))
	# Середина карты листа ложится примерно на единицу: тайл ТЕКСТУРИРУЕТ пучок,
	# а не притемняет его целиком.
	m.set_shader_parameter("shade_lo", 0.82)
	m.set_shader_parameter("shade_hi", 1.14)
	m.set_shader_parameter("wind_speed", 1.15)
	# Метёлка выше и тоньше — её мотает заметно сильнее дернины.
	m.set_shader_parameter("wind_amp", 0.16 if kind == 2 else 0.07)
	m.set_shader_parameter("wind_len", 26.0)
	# Порог низкий: мипы усредняют альфу, и при 0.5 дальняя трава пропадала бы
	# ровно там, где её и так мало.
	m.set_shader_parameter("cutoff", 0.22)
	return m


## ЗДЕСЬ БЫЛ material() — общий материал с ВЫКЛЮЧЕННЫМ отсечением задних граней,
## заведённый ради лиственной кроны из двух встречных конусов. Крона стала
## замкнутым эллипсоидом (порт из спайка 2026-08-12, вечер), и последний, кроме
## травы, потребитель CULL_DISABLED исчез. Трава свой материал строит сама
## (grass_material, там cull_disabled объявлен в самом шейдере), поэтому общего
## двустороннего материала в проекте больше нет.
##
## Запись оставлена нарочно: довод «крона просвечивала бы дырами» верен и вернётся
## вместе с любой открытой поверхностью в растительности — листом, папоротником,
## плоской кроной. Тогда материал заводится заново, а не восстанавливается по
## памяти, и вместе с ним возвращается его цена: у замкнутого тела он схлопывает
## светотень в плоский силуэт (разбор — ниже, у solid_material).


## solid_material — для ЗАМКНУТЫХ тел: ели, ствола, лиственного, куста.
##
## Отличается от material() ровно одним — отсечением задних граней, — и разница
## эта не про производительность, а про СВЕТОТЕНЬ.
##
## CULL_DISABLED заведён ради ТРАВЫ: у листа без толщины есть грань, видимая с
## изнанки. Но ель — конус, крона лиственного и куст — эллипсоиды, тела
## замкнутые, изнанки у них не видно НИКОГДА. С отключённым отсечением дальняя
## сторона всё равно рисуется, а Godot переворачивает ей нормаль как задней
## грани (bd recall godot-cull-disabled-flips-normal) — и она освещается так же,
## как ближняя. Обе стороны выходят одной яркости, градиент по конусу пропадает,
## и ель читается ПЛОСКИМ ТРЕУГОЛЬНИКОМ.
##
## Поймано сличением с запущенным спайком 2026-08-12: у него ель объёмная с
## явной освещённой и теневой сторонами, у нас — плоский тёмный силуэт. Спайк
## отсечение не выключал НИ РАЗУ: вся его растительность, кроме травы, собрана
## из замкнутых тел, а трава жила отдельным материалом. С 2026-08-12 (вечер) и у
## нас так же — лиственная крона стала эллипсоидом вместо встречных конусов, и
## последний повод для material() у растительности отпал.
static func solid_material() -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.vertex_color_use_as_albedo = true
	m.cull_mode = BaseMaterial3D.CULL_BACK
	m.roughness = 0.95
	return m
