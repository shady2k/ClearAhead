## WorldBounds — ГДЕ КОНЧАЕТСЯ МИР ДЛЯ СМОТРЯЩЕГО, и потому докуда ему можно.
##
## # Два предела, и они РАЗНОЙ ПРИРОДЫ
##
##   * ЗУМ. Ширина кадра не больше того, что загружено, — порядка удвоенной
##     дальности взгляда: столько земли и лежит поперёк круга видимости. Нельзя
##     объявить видимость в два километра и смотреть на восемь.
##   * ПОЛОЖЕНИЕ. Не дальше ОХВАТА РЕГИОНА от оси. Там мира нет вовсе — ни у
##     клиента, ни у сервера, — и это не настройка, а край света.
##
## ОБА ЧИСЛА ПРИХОДЯТ СНАРУЖИ И ПЕРЕСЧИТЫВАЮТСЯ. Охват объявляет манифест
## (ChunkRule.ceiling_reach_m), дальность выбирает игрок (rule.view_reach_m) —
## своей копии ни того, ни другого здесь нет и быть не может: это то же правило,
## по которому в клиенте нет ни одного числа правила чанков. Сменилась дальность
## — предел строится заново, и всякий, кто оказался снаружи, втягивается внутрь.
##
## # ОТВЕРГНУТО: «допустимый радиус = охват минус дальность»
##
## Первая редакция этого файла (утро 2026-08-12) вычитала дальность взгляда из
## охвата: стоя на такой границе и видя во все стороны на «дальность», смотрящий
## упирался бы ровно в край засеянного. Правило красиво само себя балансировало —
## и было ЛЕЧЕНИЕМ НЕ ТОЙ БОЛЕЗНИ.
##
## Довод владельца, которым оно отменено: «для машиниста же как-то работает вид
## почти от земли, и никаких артефактов нет». Работает — и не потому, что его вид
## устроен лучше. Рельеф грузится вокруг ОСИ ПУТИ; человек стоит на оси, значит
## он всегда в центре своего круга, земля вокруг него на всю дальность в любую
## сторону, и зума у него нет. Он физически не может попасть в плохое положение.
##
## Строитель может: орбита уезжает с оси, и край загруженного попадает в кадр —
## потому что грузилось вокруг рельсов, а не вокруг него. Лечится это НЕ упором,
## а камероцентричной загрузкой (чанки поедут за камерой), и тогда строитель
## окажется ровно в положении машиниста. Вычитание дальности было бы упором
## поверх дефекта, который правильнее убрать в другом месте, и зря отняло бы у
## игрока шесть километров из восьми.
##
## # Кадры владельца, ради которых предел по зуму всё-таки нужен
##
## Отъезд на восемь километров при мире, загруженном на два: камера смотрела
## дальше, чем сама же объявила видимость, и кадр становился белым пятном —
## дымка выводится из дальности взгляда и на восьми километрах съедает 99.9 %.
## Сколько чанков ни грузи вокруг камеры, это никуда не денется.
##
## # Почему расстояние до оси, а не прямоугольник по координатам
##
## Мир засеян КОЛЬЦАМИ ВОКРУГ ОСИ (контракт чанков §2а), а не квадратом карты:
## сервер меряет от клетки до оси, и «край света» — это линия, эквидистантная
## пути. Рамка по x и z объявила бы миром то, чего в нём нет, по углам.
class_name WorldBounds
extends RefCounted

## Ось пути в ПЛАНОВЫХ координатах сервера, та же выборка, по которой отбирались
## адреса чанков. Своей выборки здесь нет: другая дала бы другой край.
var axis := PackedVector2Array()
## Метры от оси: НАСТОЯЩАЯ граница региона, без вычетов. Отрицательное значит
## «предела нет» — так живёт мир, у которого правило подробности не собралось.
var max_offset_m := -1.0
## Метры ширины кадра.
var max_frame_m := -1.0
## Из чего сложился предел — для панели, а не для арифметики.
var reach_m := 0.0
var ceiling_m := 0.0


## from_rule — предел из ПРАВИЛА и оси. Оба числа читаются, ни одно не хранится
## копией: пересчёт — это новый вызов, а не правка полей.
static func from_rule(rule: ChunkRule, axis_pts: PackedVector2Array) -> WorldBounds:
	var b := WorldBounds.new()
	b.axis = axis_pts
	if rule == null or axis_pts.is_empty():
		return b
	b.reach_m = rule.view_reach_m()
	b.ceiling_m = rule.ceiling_reach_m()
	# Граница региона как она есть. Дальность отсюда НЕ вычитается — разбор в
	# шапке: вычитание было бы упором поверх чужого дефекта.
	b.max_offset_m = b.ceiling_m
	# Поперёк круга видимости лежит два его радиуса — столько земли и загружено.
	#
	# ЗАМЕР НА САМОМ ПРЕДЕЛЕ, а не рассуждение (снимок роли builder, FRAME=terrain,
	# дальность 2048 м): кадр 4096 м всё ещё выбелен дымкой почти целиком —
	# ортографическая камера стоит при этом в 4.4 км от фокуса, то есть вдвое
	# дальше объявленной видимости, а дымка на таком удалении съедает 96 %.
	# Предел режет бессмыслицу (восемь километров при видимости два), но читаемого
	# кадра НЕ ОБЕЩАЕТ: чтобы дальний край не тонул, кадр должен быть заметно уже
	# дальности. Насколько уже — вопрос вкуса, а не мира, и потому он не решается
	# здесь молча.
	b.max_frame_m = 2.0 * b.reach_m
	return b


func limited() -> bool:
	return max_offset_m >= 0.0 and not axis.is_empty()


## plan — точка сцены в плановых координатах сервера. Обратное преобразование
## TerrainMesh.to_godot ((x, y, z) → (x, z, −y)), и живёт оно здесь, чтобы у
## камеры и у человека был один ответ на вопрос «где это на карте».
static func plan(p: Vector3) -> Vector2:
	return Vector2(p.x, -p.z)


## nearest — ближайшая точка выборки оси.
##
## ChunkRule.nearest_axis_dist отвечает на другой вопрос — «как далеко», — и
## звать обе значило бы пройти ось дважды ради двух половин одного ответа.
## Расстояние здесь берётся ОТ ЭТОЙ ЖЕ точки (offset_of ниже), поэтому двух
## ответов не возникает.
func nearest(p: Vector2) -> Vector2:
	var best := p
	var best_d := INF
	for a in axis:
		var d := p.distance_squared_to(a)
		if d < best_d:
			best_d = d
			best = a
	return best


func offset_of(p: Vector2) -> float:
	return p.distance_to(nearest(p))


## pull_in — втянуть точку внутрь предела. Уже внутри — возвращается как есть.
##
## Втягивание идёт ПО ПРЯМОЙ К ОСИ, а не сбросом в начало: смотрящий, которого
## переставили на другой конец станции, не понял бы, что произошло, — а он всего
## лишь доехал до края.
func pull_in(p: Vector3) -> Vector3:
	if not limited():
		return p
	var flat := plan(p)
	var near := nearest(flat)
	var d := flat.distance_to(near)
	if d <= max_offset_m or d <= 0.0:
		return p
	var pulled := near + (flat - near) / d * max_offset_m
	return Vector3(pulled.x, p.y, -pulled.y)


## outside — насколько точка вышла за предел, метры. Ноль и меньше — внутри.
func outside(p: Vector3) -> float:
	if not limited():
		return -1.0
	return offset_of(plan(p)) - max_offset_m


## text — из чего сложился предел. Оба предела названы порознь и с их причинами:
## один приехал манифестом (край света), другой выбрал игрок (докуда смотрит), и
## слитые в одно число они выглядели бы одним фактом о мире.
func text() -> String:
	if not limited():
		return "предела нет: правило подробности или ось не собраны"
	return ("от оси не дальше %.0f м — там мира нет ни у кого (охват региона); "
		+ "кадр не шире %.0f м — вдвое дальность взгляда (%.0f м), а смотреть дальше видимости нечем") % [
			max_offset_m, max_frame_m, reach_m]
