## rebuild_queue.gd — ОЧЕРЕДЬ РАБОТ ПЕРЕСТРОЙКИ ПОД БЮДЖЕТОМ КАДРА (sqym.7).
##
## Это не список дел, а дисциплина: тяжёлая работа перестройки набора версии
## раскладывается на продолжаемые задания, каждое выполняется кусочками, и за
## один кадр уходит не больше объявленного бюджета. Превышение не прячется: шаг,
## съевший весь бюджет целиком, назван в отчёте, и проверка краснеет.
##
## Три свойства, которые бриф W6-A называет поимённо, живут здесь:
##
##   • БЮДЖЕТ — число, а не намерение. Очередь меряет каждое задание своими
##     часами и сообщает, кто превысил лимит шага. Часы инжектируются: проверка
##     гоняет очередь на фикстурном времени и видит превышение, не дожидаясь
##     реальной секунды.
##
##   • ПРЕРЫВАЕМОСТЬ. Задание можно бросить на середине (cancel): его состояние
##     выбрасывается, а не доделывается. Продолжаемость — контракт шага: всё,
##     что переживает границу кадра, лежит в state задания, и прерванное
##     задание может быть вытеснено и возобновлено, не начинаясь заново.
##
##   • ПЕРЕУПОРЯДОЧИВАЕМОСТЬ. Приоритеты пересчитываются по ходу
##     (reprioritize_all): задание, поставленное в очередь три кадра назад для
##     клетки, которая уже за спиной, уступает место тому, на что игрок смотрит
##     сейчас. Текущее задание при этом ВЫТЕСНЯЕТСЯ в очередь — состояние его
##     сохраняется, следующий кадр продолжит его с того же места.
##
## Очередь НЕ знает, что строит: шаг — Callable, состояние — словарь. Земля,
## трава, коллизии и путь собираются одними и теми же правилами, и это
## нарочно — «у каждой статьи свой планировщик» значило бы четыре раза
## изобрести бюджет.
class_name RebuildQueue
extends RefCounted

## Задание: {id, step: Callable, priority: float, state: Dictionary, cost_us: int}.
##
## step(budget_us, t0, state) -> true, когда задание закончено.
##   budget_us — бюджет ВСЕГО кадра (от начала work), а не остаток: шаг сам
##     решает, сколько успеть, и сверяет свой расход с t0. Очередь не лезет в
##     зернистость — она только меряет её и жалуется, когда шаг груб.
##   t0 — метка начала текущего work (часы _now).
##   state — словарь задания; всё, что переживает границу кадра, обязано лежать
##     в нём. Задание без состояния (всё делает за один шаг) — законно.
var _jobs: Array[Dictionary] = []   # невыполненные, в порядке приоритета
var _by_id := {}                    # id -> задание, для отмены и пересортировки
var _current: Dictionary = {}       # задание в руках; пустое — очередь свободна
var _now: Callable                  # часы; отдельные от Time ради проверок


func _init(now: Callable = Callable(Time, "get_ticks_usec")) -> void:
	_now = now


## push — поставить задание. Дубль id — замена: приоритет и шаг нового задания
## вытесняют старые, состояние остаётся прежним, если оно не пересоздано явно
## (замена шага — способ «пересадить» задание, не потеряв его курсор).
func push(id: String, step: Callable, priority: float, state: Dictionary = {}) -> void:
	var job: Dictionary = _by_id.get(id, {})
	job["id"] = id
	job["step"] = step
	job["priority"] = priority
	job["state"] = state
	if not job.has("cost_us"):
		job["cost_us"] = 0
	if not _by_id.has(id):
		_by_id[id] = job
		_jobs.append(job)
	# Очередь держится отсортированной по возрастанию приоритета: фронт — то,
	# что нужно сейчас. Сортировка целиком на каждый push дороже, чем вставка,
	# но очереди здесь сотни заданий, а не миллионы, и простота честнее.
	_jobs.sort_custom(func(a, b): return float(a["priority"]) < float(b["priority"]))


func pending() -> int:
	return _jobs.size() + (0 if _current.is_empty() else 1)


## cancel — бросить задание на середине. И из очереди, и из рук: текущее
## задание, ставшее ненужным, не доделывается — его курсор выбрасывается.
func cancel(id: String) -> void:
	if not _by_id.has(id):
		return
	_by_id.erase(id)
	_jobs = _jobs.filter(func(j): return j["id"] != id)
	if not _current.is_empty() and _current["id"] == id:
		_current = {}


func clear() -> void:
	_jobs = []
	_by_id = {}
	_current = {}


func has(id: String) -> bool:
	return _by_id.has(id)


## reprioritize_all — пересчитать приоритеты по ходу и переупорядочить очередь.
##
## fn(job) -> float: новое число задания (job — словарь задания: id, priority,
## state, cost_us). Текущее задание, переставшее быть самым срочным,
## ВЫТЕСНЯЕТСЯ в очередь со своим состоянием — продолжаемое задание
## возобновится с того же места, когда до него дойдёт очередь снова. Это и есть
## «клетка за спиной уступает видимой»: камера двинулась, и очередь
## перестроилась по новым расстояниям, не теряя ни одного курсора.
func reprioritize_all(fn: Callable) -> void:
	for j in _jobs:
		j["priority"] = float(fn.call(j))
	# Сначала очередь по новым приоритетам — и только потом сравнение фронта с
	# текущим заданием: несортированный _jobs[0] не обязан быть самым срочным.
	_jobs.sort_custom(func(a, b): return float(a["priority"]) < float(b["priority"]))
	if not _current.is_empty():
		_current["priority"] = float(fn.call(_current))
		if not _jobs.is_empty() and float(_jobs[0]["priority"]) < float(_current["priority"]):
			_jobs.append(_current)
			_current = {}
			_jobs.sort_custom(func(a, b): return float(a["priority"]) < float(b["priority"]))

## work — выполнять задания, пока не вышел бюджет кадра.
##
## Возвращает {spent_us, done, over_budget}:
##   spent_us — реально потрачено (часы _now);
##   done — заданий закончено за кадр;
##   over_budget — задания, чей ОДИН шаг съел весь бюджет: их зернистость груба,
##     и это не молчаливый проступок, а число, по которому статью режут мельче.
##
## Задание, не законченное за кадр, остаётся в _current со своим состоянием и
## продолжается со следующего кадра — в том числе после переупорядочивания.
func work(budget_us: int) -> Dictionary:
	var t0: int = _now.call()
	var done := 0
	var over: Array[String] = []
	while true:
		if _current.is_empty():
			if _jobs.is_empty():
				break
			_current = _jobs.pop_front()
		var started: int = _now.call()
		var id := String(_current["id"])
		var finished: bool = _current["step"].call(budget_us, t0, _current["state"])
		var cost: int = _now.call() - started
		_current["cost_us"] = int(_current["cost_us"]) + cost
		if finished:
			done += 1
			_by_id.erase(id)
			_current = {}
		if _now.call() - t0 >= budget_us:
			# Шаг съел кадр целиком — зернистость груба, и это не молчаливый
			# проступок, а число, по которому статью режут мельче. Задание,
			# закончившееся таким шагом, тоже называется: оно превысило лимит,
			# хоть и успело.
			if cost >= budget_us:
				over.append(id)
			break
	return {"spent_us": _now.call() - t0, "done": done, "over_budget": over}
