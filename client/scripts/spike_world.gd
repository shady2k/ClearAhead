const NORMAL_SIGN := -1.0

## --- путь: чтобы читался железной дорогой -----------------------------------
## Инвариант всех натурных снимков: БАЛЛАСТ СВЕТЛЕЕ ШПАЛ, А ГОЛОВКА РЕЛЬСА —
## самое яркое место в кадре. Палитра «по натуре» из спайка №1 физически верна
## (щебень 0.18-0.22), но даёт три тёмных поверхности подряд, и путь сливается в
## одну серую ленту. Здесь щебень поднят до сухого светлого, шпалы оставлены
## тёмными, а рельс разделён на две поверхности: тело (ржавое, матовое) и накат
## (полированная сталь, зеркальная).
## Число подобрано ПОД РАМПУ ЗЕРНА, а не по таблице отражений: текстура щебня
## умножает альбедо на 0.72..1.0 (см. _stone_texture), и «правильные» 0.36 после
## неё давали ту самую чёрную насыпь. Здесь 0.60 сверху × 0.83 в среднем даёт на
## поверхности примерно 0.5 — сухой светлый щебень, который и нужен глазу.
const CW_BALLAST := Color(0.50, 0.48, 0.45)   # сухой щебень на солнце
const CW_SLEEPER := Color(0.22, 0.17, 0.13)   # пропитанная шпала
const CW_RAIL := Color(0.24, 0.19, 0.16)      # бок и подошва: ржавчина
const CW_RAILHEAD := Color(0.62, 0.63, 0.66)  # накат: по нему идёт колесо
const RAILHEAD_W := 0.062        # м — ширина наката
const RAILHEAD_T := 0.004        # м — насколько накат выступает над головкой

var _railhead := SurfaceTool.new()

var _n_hill := FastNoiseLite.new()
var _n_mid := FastNoiseLite.new()
var _n_forest := FastNoiseLite.new()
var _n_tone := FastNoiseLite.new()
var _n_species := FastNoiseLite.new()   # какая порода растёт: рощами, не жребием
var _n_veg := FastNoiseLite.new()       # сомкнулся ли покров: плешины голой почвы
var _n_tuft := FastNoiseLite.new()      # куртины: где трава выше и гуще
var _n_bush := FastNoiseLite.new()      # заросли кустов на открытом лугу
var _rng := RandomNumberGenerator.new()
var _corridor := {}              # ключ ячейки -> true: там путь, лесу нельзя
var _h_grid := []                # кэш поля высот после земляных работ
var _h_nx := 0
var _h_nz := 0

## Настройка шумов вынесена из _ready отдельным методом НАРОЧНО: поле высот —
## чистая функция координат, и её надо уметь мерить без сцены, окна и рендера.
## Зонд (tools/terrain_probe.gd) создаёт этот класс через .new(), зовёт
## _setup_noise() и считает статистику по _ground_natural напрямую. Пока настройка
## сидела внутри _ready, зонду приходилось держать КОПИЮ формулы рельефа — а копия
## расходится с оригиналом на первой же правке, и мерить начинаешь не то.
func _setup_noise() -> void:
	_n_hill.seed = 0x5EED
	# ЧАСТОТА ЗДЕСЬ ЕДИНИЧНАЯ И ОКТАВА ОДНА. FastNoiseLite умножает координату на
	# собственную frequency и сам фрактализует — а FBM с эрозией мы считаем свой,
	# со своими частотами. Иначе частоты перемножаются (0.0016 × 0.0016), и шум
	# на всю карту выходит почти константой: земля идеально гладкая при любых
	# настройках эрозии. Ровно это и было.
	_n_hill.frequency = 1.0
	_n_hill.fractal_type = FastNoiseLite.FRACTAL_NONE
	_n_mid.seed = 0x31D6E
	_n_mid.frequency = 0.011      # период ~90 м — бугор размером с посёлок
	_n_mid.fractal_octaves = 3
	_n_forest.seed = 0xF0E5
	_n_forest.frequency = 0.0032
	_n_forest.fractal_octaves = 3
	_n_tone.seed = 0x70E
	_n_tone.frequency = 0.010
	# Период ~180 м: роща занимает заметную часть кадра диспетчера, а не мельтешит.
	_n_species.seed = 0x59EC
	_n_species.frequency = 0.0055
	_n_species.fractal_octaves = 2
	# Покров: период ~45 м — плешина размером с двор, и она выразима вершинной
	# сеткой с шагом 5 м. Две октавы, а не три: третья ушла бы под Найквист.
	_n_veg.seed = 0x7E6E
	_n_veg.frequency = 0.028
	_n_veg.fractal_octaves = 2
	# Куртины травы: период ~11 м. Цвет земли этого масштаба не несёт (см. VEG_*),
	# а посадка несёт — трава редеет и вырастает пятнами внутри одной дернины.
	_n_tuft.seed = 0x7A17
	_n_tuft.frequency = 0.09
	_n_tuft.fractal_octaves = 2
	# Заросли кустов: период ~77 м. Кусты сидят куртинами, а не поштучно по полю.
	_n_bush.seed = 0xB05
	_n_bush.frequency = 0.013
	_n_bush.fractal_octaves = 2
	_rng.seed = 0xC1EA5

## Сомкнутость покрова в точке: 0 — голая почва, 1 — сплошная дернина.
## Спрашивают трое: цвет вершины, трава и кусты (см. развёрнутое обоснование
## у объявления VEG_BARE).
func _veg_density(x: float, z: float) -> float:
	return smoothstep(VEG_BARE, VEG_FULL, 0.5 + 0.5 * _n_veg.get_noise_2d(x, z))

## Доля массива леса в точке. Тот же порог, по которому сажаются деревья.
func _forest_mask(x: float, z: float) -> float:
	return clampf((_n_forest.get_noise_2d(x, z) - 0.02) * 5.0, 0.0, 1.0)

func _ready() -> void:
	_setup_noise()
	_railhead.begin(Mesh.PRIMITIVE_TRIANGLES)  # наполняется из _add_rails внутри super()
	# Сглаживание кромок. Путь — это сотни тонких рёбер (рельсы, шпалы, ёлки), и
	# без MSAA они на общем плане рассыпаются в дрожащую крапку: издали кажется,
	# что дело в цвете, а дело в кромке.
	get_viewport().msaa_3d = Viewport.MSAA_4X
	# MSAA сглаживает КРОМКУ, но не блик внутри грани. Ограничитель шероховатости
	# — второе средство, ровно против пунктира на рельсах.
	RenderingServer.screen_space_roughness_limiter_set_active(true, 0.25, 0.18)

	super()                       # путь, земля, свет, камера — всё из родителя

	_commit(_railhead, _mat_railhead())
	_build_corridor_mask()
	_add_water()
	_add_forest()
	_add_bushes()
	_add_grass()
	_add_village()

## --- управление камерой ------------------------------------------------------
## ЗУМ НА МАКЕ. Родитель слушает только колесо мыши, а macOS шлёт двупальцевый
## скролл как InputEventPanGesture и щипок как InputEventMagnifyGesture —
## колеса не приходит вовсе, и зум выглядит сломанным. Плюс клавиши +/- как
## средство, которое работает на любом вводе.
func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventPanGesture:
		_zoom_by(pow(1.06, event.delta.y))
		get_viewport().set_input_as_handled()
		return
	if event is InputEventMagnifyGesture:
		_zoom_by(1.0 / maxf(event.factor, 0.01))
		get_viewport().set_input_as_handled()
		return
	if event is InputEventKey and event.pressed:
		if event.keycode == KEY_EQUAL or event.keycode == KEY_KP_ADD:
			_zoom_by(0.8)
			get_viewport().set_input_as_handled()
			return
		if event.keycode == KEY_MINUS or event.keycode == KEY_KP_SUBTRACT:
			_zoom_by(1.25)
			get_viewport().set_input_as_handled()
			return
	super(event)

## Множитель больше единицы — отдаляемся. Пределы шире родительских: спайк мира
## больше станции, и упереться в потолок зума на нём легко.
func _zoom_by(f: float) -> void:
	if _cam_ortho:
		_cam_size = clampf(_cam_size * f, 2.0, 1200.0)
	else:
		_cam_dist = clampf(_cam_dist * f, 4.0, 6000.0)
	_apply_camera()

## --- путь -------------------------------------------------------------------
## Двутавр вместо бруска: подошва 150, шейка 22, головка 71 мм — пропорции Р65,
## сжатые по высоте до RAIL_H. Высоту не трогаем нарочно: от неё считают верх
## рельса платформа, упоры и эталонная коробка.
const RAIL_FOOT_HALF := 0.075    # м — полуширина подошвы
const RAIL_FOOT_H := 0.030       # м — высота подошвы
const RAIL_WEB_HALF := 0.011     # м — полуширина шейки
const RAIL_HEAD_HALF := 0.0355   # м — полуширина головки: ею меряется колея
const RAIL_HEAD_H := 0.045       # м — высота головки

## Колея меряется по внутренним граням ГОЛОВОК, а у двутавра головка уже подошвы.
func _rail_head_half() -> float:
	return RAIL_HEAD_HALF

func _rail_foot_half() -> float:
	return RAIL_FOOT_HALF

func _rail_section(y0: float) -> PackedVector3Array:
	var fw := RAIL_FOOT_HALF
	var fh := RAIL_FOOT_H
	var ww := RAIL_WEB_HALF
	var hw := RAIL_HEAD_HALF
	var hh := RAIL_HEAD_H
	var top := RAIL_H
	return PackedVector3Array([
		Vector3(-fw, y0, 0.0), Vector3(-fw, y0 + fh, 0.0),
		Vector3(-ww, y0 + fh + 0.022, 0.0), Vector3(-ww, y0 + top - hh, 0.0),
		Vector3(-hw, y0 + top - hh + 0.012, 0.0), Vector3(-hw, y0 + top, 0.0),
		Vector3(hw, y0 + top, 0.0), Vector3(hw, y0 + top - hh + 0.012, 0.0),
		Vector3(ww, y0 + top - hh, 0.0), Vector3(ww, y0 + fh + 0.022, 0.0),
		Vector3(fw, y0 + fh, 0.0), Vector3(fw, y0, 0.0),
	])

## Накат — отдельная поверхность поверх головки, а не материал всего рельса.
## Это то самое, по чему путь узнают с любой высоты: две блестящие нити. У
## целого рельса такого сделать нельзя — бока и подошва обязаны быть ржавыми.
func _add_rails(tool: SurfaceTool, el: Dictionary, lift: float) -> void:
	super(tool, el, lift)
	var typ := _type()
	if typ.is_empty():
		return
	var g := _rail_axis_offset(float(typ.gauge))
	var y := _rail_sole() + lift + RAIL_H
	var sec := PackedVector3Array([
		Vector3(-RAILHEAD_W * 0.5, y - 0.002, 0.0),
		Vector3(-RAILHEAD_W * 0.5, y + RAILHEAD_T, 0.0),
		Vector3(RAILHEAD_W * 0.5, y + RAILHEAD_T, 0.0),
		Vector3(RAILHEAD_W * 0.5, y - 0.002, 0.0),
	])
	for sign in [1.0, -1.0]:
		_extrude(_railhead, _offset_chain3d(el, g * sign), sec, false, false)

## ЩЕБЕНЬ — КЛЕТОЧНЫМ ШУМОМ, А НЕ ПЕРЛИНОМ. Родительский _mat кладёт гладкий
## перлин без карты нормалей, и вблизи балласт читается серой лентой с разводами:
## у перлина по построению нет высоких частот, при увеличении он даёт мыло и
## больше ничего. Клеточный шум (Ворлей) состоит из ЯЧЕЕК С ГРАНИЦАМИ — это и
## есть камень: F2-F1 даёт светлую грань между зёрнами, то есть шов между
## щебёнками. Та же карта, поданная нормалью, зажигает на каждом зерне свой блик,
## и балласт становится сыпучим, а не крашеным.
const BALLAST_STONE := 0.050     # м — характерный размер щебёнки (натура: 3-6 см)
const BALLAST_TILE := 512        # px — сторона тайла
const BALLAST_CELL_PX := 32.0    # px — сторона ячейки в тайле, она же 1/frequency

func _mat_ballast() -> StandardMaterial3D:
	# Период тайла в мире: столько щебёнок, сколько их укладывается в тайл.
	# BALLAST_CELL_PX — сторона ячейки в пикселях, 1/frequency клеточного шума.
	var cells := float(BALLAST_TILE) / BALLAST_CELL_PX
	var period := BALLAST_STONE * cells
	var m := StandardMaterial3D.new()
	m.albedo_color = CW_BALLAST
	m.roughness = 1.0
	m.albedo_texture = _stone_texture(false)
	m.normal_enabled = true
	m.normal_texture = _stone_texture(true)
	m.normal_scale = 1.5
	# Меши из SurfaceTool идут без UV — трипланар берёт координаты из мировой
	# позиции. uv1_scale — это МНОЖИТЕЛЬ координаты, то есть 1/период.
	m.uv1_triplanar = true
	m.uv1_scale = Vector3.ONE / period
	return m

## Одна и та же клеточная карта в двух ролях: пятном альбедо и нормалью.
func _stone_texture(as_normal: bool) -> NoiseTexture2D:
	var noise := FastNoiseLite.new()
	noise.seed = 0xB0115
	noise.noise_type = FastNoiseLite.TYPE_CELLULAR
	# F2-F1: ноль в середине зерна, максимум на границе с соседним. Именно эта
	# разность рисует шов; F1 в одиночку даёт «пупырышки», а не колотый камень.
	noise.cellular_return_type = FastNoiseLite.RETURN_DISTANCE2_SUB
	noise.cellular_distance_function = FastNoiseLite.DISTANCE_EUCLIDEAN
	noise.cellular_jitter = 1.0        # полный разброс центров: ряды не читаются
	noise.frequency = 1.0 / BALLAST_CELL_PX
	noise.fractal_type = FastNoiseLite.FRACTAL_NONE
	var nt := NoiseTexture2D.new()
	nt.width = BALLAST_TILE
	nt.height = BALLAST_TILE
	# SEAMLESS ЗДЕСЬ ВРЕДЕН. NoiseTexture2D делает бесшовность кросс-фейдом тайла
	# с самим собой: для перлина это незаметно, а клеточный шум от наложения двух
	# сеток ячеек теряет ровно то, ради чего взят, — границу зерна. Первый заход с
	# seamless дал наждак вместо щебня. Шов тайла на балласте не виден: полоса
	# узкая, тайл 0.5 м, а зерно случайное.
	nt.seamless = false
	nt.noise = noise
	if as_normal:
		nt.as_normal_map = true
		nt.bump_strength = 24.0
	else:
		# Разброс яркости по зерну: щебень серый, но не одного тона. Середина
		# зерна светлая, шов между зёрнами — тень.
		#
		# РАМПА ТОЛЬКО ГАСИТ, ПОДНЯТЬ ОНА НЕ МОЖЕТ. Здесь стояли 1.30 и 1.70 в
		# расчёте на «пересвет» — но рампа печётся в RGBA8, и всё выше единицы
		# там обрезается. То есть верхний конец на деле был 1.0, а работал только
		# нижний: у клеточного шума F2-F1 бо́льшая часть площади — СЕРЕДИНА зерна,
		# то есть малые значения, и они попадали в 0.38-0.70. Текстура съедала
		# примерно две трети альбедо, и «сухой светлый щебень» выходил на снимке
		# почти чёрным — это и увидел владелец.
		#
		# Раз множитель не может быть больше единицы, светлоту задаёт ЦВЕТ
		# (CW_BALLAST), а рампа оставляет себе только фактуру: неглубокую тень в
		# шве между зёрнами. Размах 0.72..1.0 вместо 0.38..1.0.
		var ramp := Gradient.new()
		ramp.offsets = PackedFloat32Array([0.0, 0.30, 0.75, 1.0])
		ramp.colors = PackedColorArray([
			Color(0.62, 0.62, 0.62), Color(0.82, 0.82, 0.82),
			Color(1.00, 1.00, 1.00), Color(1.00, 1.00, 1.00)])
		nt.color_ramp = ramp
	return nt

## ДЕРЕВО — НАПРАВЛЕННЫЙ ШУМ. Родительский _mat выдавал шпале ТОТ ЖЕ перлин, что
## и балласту (seed 0xC1EA, frequency 0.05), различался только масштаб — владелец
## заметил это сам. Разные материалы отличаются не цветом поверх общего шума, а
## пространственными частотами и направленностью: у щебня зерно круглое и
## одинаковое во все стороны, у дерева волокно вытянуто вдоль бруса.
##
## ОГРАНИЧЕНИЕ, ЧЕСТНО. Направление берётся анизотропным uv1_scale, то есть в
## МИРОВЫХ осях: волокно вытянуто вдоль Z. Шпалы лежат поперёк пути, а путь в
## нашей фикстуре идёт в основном вдоль X — значит совпадает. На дуге и на путях
## под углом волокно поедет. Правильное лечение — свои UV на коробке шпалы
## (u вдоль бруса, v поперёк); родительский _quad их не кладёт, и это отдельная
## работа. Здесь взят дешёвый вариант с известной границей применимости.
const SLEEPER_GRAIN := 0.045     # м — период волокна ПОПЕРЁК бруса
const SLEEPER_RUN := 2.2         # м — период рисунка ВДОЛЬ бруса

func _mat_sleeper() -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = CW_SLEEPER
	m.roughness = 0.82
	m.albedo_texture = _wood_texture(false)
	m.normal_enabled = true
	m.normal_texture = _wood_texture(true)
	m.normal_scale = 0.7          # дерево почти плоское: рельеф даёт трещина, не волокно
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(1.0 / SLEEPER_GRAIN, 1.0 / SLEEPER_RUN, 1.0 / SLEEPER_RUN)
	return m

## Волокно с редкими тёмными трещинами. Шум БЕЗ seamless — по той же причине, что
## у щебня: кросс-фейд тайла с самим собой мылит рисунок.
func _wood_texture(as_normal: bool) -> NoiseTexture2D:
	var noise := FastNoiseLite.new()
	noise.seed = 0x0D06                        # свой, не общий 0xC1EA
	noise.noise_type = FastNoiseLite.TYPE_PERLIN
	noise.frequency = 0.09
	noise.fractal_octaves = 4
	var nt := NoiseTexture2D.new()
	nt.width = 256
	nt.height = 256
	nt.seamless = false
	nt.noise = noise
	if as_normal:
		nt.as_normal_map = true
		nt.bump_strength = 6.0
	else:
		# Резкий тёмный край слева — это и есть трещина: рампа с уступом, а не
		# плавный градиент, иначе выходит та же серая муть.
		var ramp := Gradient.new()
		ramp.offsets = PackedFloat32Array([0.0, 0.16, 0.30, 1.0])
		ramp.colors = PackedColorArray([
			Color(0.34, 0.34, 0.34), Color(0.62, 0.62, 0.62),
			Color(1.05, 1.05, 1.05), Color(1.34, 1.34, 1.34)])
		nt.color_ramp = ramp
	return nt

## СТАЛЬ. Тело рельса ржавое, а ржавчина — ДИЭЛЕКТРИК: metallic 0, шероховатость
## высокая. Металлом остаётся только накат (_mat_railhead), по которому идёт
## колесо. Прежние 0.55/0.35 были ни то ни другое: полуметалл, какого не бывает.
func _mat_rail() -> StandardMaterial3D:
	return _mat(CW_RAIL, 0.85, 0.0)

## Накат зеркалить нельзя. Проверено подменой материала: у матового наката нить
## идеально ровная, у зеркального она рассыпается в пунктир — это БЛИКОВЫЙ
## АЛИАСИНГ (полоса шириной 6 см занимает меньше пикселя, и блик то попадает в
## его центр, то нет), а не z-fighting: подъём наката на 5 см картинку не менял.
## Лечится шероховатостью (блик становится шире пикселя) и ограничителем
## шероховатости по экрану — он поднимает roughness там, где нормаль пляшет.
## metallic 1.0, а не 0.85: накат — это полированная колесом сталь, и полуметалла
## не бывает. Шероховатость 0.22, а не 0.08-0.18 «по науке»: ниже возвращается
## бликовый алиасинг из комментария выше, а ограничитель по экрану его гасит
## только отчасти. Это осознанный размен резкости блика на целую нить.
func _mat_railhead() -> StandardMaterial3D:
	return _mat(CW_RAILHEAD, 0.22, 1.0)

## --- рельеф -----------------------------------------------------------------
## --- FBM: фрактальный шум для неправильности рельефа ---------------------------
## Поворот координат между октавами (матрица 0.8/0.6) убирает решётчатость,
## которая иначе накапливается по осям.
##
## ЗДЕСЬ БЫЛА ЭРОЗИЯ ПО КИЛЕЗУ (iquilezles.org/articles/morenoise) — вклад каждой
## октавы делился на (1 + k*|градиент|²), чтобы на склоне мелкая деталь гасилась,
## а на пологом оставалась: гребни и промоины вместо «шума по шуму». Приём
## настоящий, но ЗДЕСЬ ОН НЕ РАБОТАЛ И РАБОТАТЬ НЕ МОГ, и это замерено, а не
## решено на вкус.
##
## Сначала нашлась ошибка единиц: градиент накапливался в единицах шума вместо
## метров на метр и был занижен примерно в 17 раз, а входит он квадратом — то
## есть в 300. Делитель по всей карте выходил 1.02 при 1.0 = «эрозии нет вовсе».
## После правки единиц зонд прогнал развёртку по силе K на окне станции, меряя
## то, ради чего приём и берут: отношение мелкой детали на крутых местах к
## пологим (эрозия обязана давать заметно МЕНЬШЕ единицы):
##
##   K=0     1.094      K=300    1.043
##   K=100   1.070      K=1000   1.012      K=3000   1.012
##
## Ниже единицы не опускается никогда, сколько ни давай. Причина в спектре: при
## FBM_GAIN = 0.52 старшие октавы несут 2 % амплитуды, а их периоды (7-15 м)
## лежат на границе того, что сетка с шагом W_STEP = 5 м вообще способна
## выразить. Гасить нечего — мелкой детали в этом рельефе нет по построению.
## У Килеза приём работает на рельефе с высокими частотами; у нас их не будет,
## пока деталь ближнего плана делает не сетка, а покров и трава.
##
## Удаление стоило 28 выборок шума из 35 на узел: осталось по одной на октаву
## вместо пяти (значение плюс четыре для центральной разности).
## Октав шесть, а не семь: седьмая имела период 7.2 м при шаге сетки 5 м, то
## есть лежала ниже предела Найквиста и добавляла не деталь, а алиасинг.
const FBM_OCTAVES := 6
const FBM_BASE_FREQ := 0.0016   # 1/м — период старшей октавы ~600 м
const FBM_LACUNARITY := 2.1
const FBM_GAIN := 0.52
## Размах FBM. Было 34 м — вместе с синусами это давало ±20 м вокруг пути,
## который сам поднимается на 2.6 м (см. вертикальный бюджет у LAND_BASE).
const FBM_AMP := 13.0           # м — размах до нормировки

## ТРИ МАСШТАБА, А НЕ ОДИН. Здесь были только километровые волны, и с высоты
## станции земля читалась надувным шаром: гладкой её делал не рендер, а
## отсутствие бугров того размера, который в кадре вообще видно (30-100 м).
## Мельче шага сетки (W_STEP) выразить нельзя ничего — оттуда и шаг 5 м.
## Широкие пологие холмы: два синуса на километр плюс фрактальный шум для
## неправильности. Мелкая рябь спайка №1 убрана — она читалась ковром, а не
## землёй, и съедала весь контраст, который должны давать лес и вода.
func _ground_natural(x: float, z: float) -> float:
	return _carve_river(x, z, _soft_floor(_land_raw(x, z)))

## Сырая суша: до пола и до реки. Вынесена отдельно, чтобы зонд мог померить
## РАСПРЕДЕЛЕНИЕ высот до всякой обработки — решение про пол принимается по нему,
## а не на глаз.
func _land_raw(x: float, z: float) -> float:
	return LAND_BASE \
		+ LAND_SIN_X * sin(x * 0.00120 - 0.5) \
		+ LAND_SIN_Z * cos(z * 0.00160 + 1.1) \
		+ _fbm(x, z) \
		+ MID_AMP * _n_mid.get_noise_2d(x, z)

## Мягкий пол: выше LAND_SOFT высота не трогается вовсе, ниже — сжимается к
## асимптоте LAND_FLOOR. См. развёрнутое обоснование у объявления констант.
func _soft_floor(h: float) -> float:
	if h >= LAND_SOFT:
		return h
	var span := LAND_SOFT - LAND_FLOOR
	return LAND_SOFT - span * (1.0 - exp((h - LAND_SOFT) / span))

## Значение FBM. Считается ОДИН раз на узел сетки (см. кэш высот) — деревьям и
## домам отметки достаются из готовой сетки, а не пересчётом шума.
func _fbm(x: float, z: float) -> float:
	var p := Vector2(x, z)
	var rot := Transform2D(Vector2(0.8, -0.6), Vector2(0.6, 0.8), Vector2.ZERO)
	var freq := FBM_BASE_FREQ
	var amp := 1.0
	var sum := 0.0
	var norm := 0.0
	for i in FBM_OCTAVES:
		sum += amp * _n_hill.get_noise_2d(p.x * freq, p.y * freq)
		norm += amp
		amp *= FBM_GAIN
		freq *= FBM_LACUNARITY
		p = rot * p
	return FBM_AMP * sum / norm

## Ось реки — меандр по x. Река идёт вдоль северного края и путь не пересекает:
## моста в спайке нет, а путь по воде — это не стилизация, это баг на картинке.
func _river_z(x: float) -> float:
	return 340.0 + 78.0 * sin(x * 0.0034 + 0.4) + 26.0 * cos(x * 0.0079 - 1.2)

func _carve_river(x: float, z: float, h: float) -> float:
	var d := absf(z - _river_z(x))
	if d > RIVER_HALF + RIVER_BANK:
		return h
	if d <= RIVER_HALF:
		return RIVER_BED
	var t := (d - RIVER_HALF) / RIVER_BANK
	t = t * t * (3.0 - 2.0 * t)
	return lerpf(RIVER_BED, h, t)

## --- земля: сетка с цветом покрова в вершинах ---------------------------------
## Родительский _add_ground кладёт один зелёный на всю площадь. Здесь цвет —
## функция места: песок у воды, два тона луга по шуму, тёмный подлесок под
## массивом леса, грунт на крутизне. Это тот же приём, что у референса: контраст
## даёт покров, а не освещение.
func _add_ground() -> void:
	var nx := int((W_X1 - W_X0) / W_STEP) + 1
	var nz := int((W_Z1 - W_Z0) / W_STEP) + 1
	var h := []
	h.resize(nx)
	for i in nx:
		var col := PackedFloat32Array()
		col.resize(nz)
		for j in nz:
			col[j] = _ground_worked(W_X0 + i * W_STEP, W_Z0 + j * W_STEP)
		h[i] = col
	# Кэш: после эрозии одна отметка стоит 30 выборок шума, а деревьям и домам
	# нужны десятки тысяч отметок. Берём их из УЖЕ ПОСЧИТАННОЙ сетки — заодно
	# они гарантированно стоят на нарисованной поверхности, а не рядом с ней.
	_h_grid = h
	_h_nx = nx
	_h_nz = nz
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in nx - 1:
		var ci: PackedFloat32Array = h[i]
		var cj: PackedFloat32Array = h[i + 1]
		var x0 := W_X0 + i * W_STEP
		var x1 := x0 + W_STEP
		for j in nz - 1:
			var z0 := W_Z0 + j * W_STEP
			var z1 := z0 + W_STEP
			var p0 := Vector3(x0, ci[j], z0)
			var p1 := Vector3(x1, cj[j], z0)
			var p2 := Vector3(x1, cj[j + 1], z1)
			var p3 := Vector3(x0, ci[j + 1], z1)
			# Уклон квада — по разнице отметок его углов; на него завязан грунт.
			var slope := maxf(absf(ci[j] - cj[j]), absf(ci[j] - ci[j + 1])) / W_STEP
			# НОРМАЛЬ В ВЕРШИНЕ, А НЕ В ГРАНИ. Плоская нормаль на грань — и есть
			# та угловатость: при шаге 7 м каждый квад заливается своим тоном, и
			# холм превращается в гранёный ком. Нормаль берётся из САМОГО ПОЛЯ
			# высот центральной разностью, поэтому она непрерывна через границу
			# квада, и заливка склеивается в гладкий скат при той же сетке.
			_quad_cn(tool, p0, p1, p2, p3,
				_terrain_normal(h, nx, nz, i, j), _terrain_normal(h, nx, nz, i + 1, j),
				_terrain_normal(h, nx, nz, i + 1, j + 1), _terrain_normal(h, nx, nz, i, j + 1),
				_cover(p0, slope), _cover(p1, slope), _cover(p2, slope), _cover(p3, slope))
	_commit(tool, _mat_ground())
	_add_skirt(h, nx, nz)

## ПОКРОВ СЧИТАЕТСЯ НА ПИКСЕЛЬ, А НЕ В ВЕРШИНЕ. Здесь стояла шумовая текстура
## ±12 % поверх цвета вершины, и земля выходила ровной зелёной заливкой на любом
## приближении. Причина не в силе шума, а в том, где считается цвет:
##
##   * вершины поля высот стоят через W_STEP (5 м), поэтому вершинным цветом
##     нельзя выразить НИЧЕГО мельче двух шагов — 10 м. Прежний _cover брал
##     мелкий тон как get_noise_2d(x*7, z*7), период ~14 м: этот член не давал
##     детали, он давал шум на границе Найквиста;
##   * а ±12 % серого поверх — это модуляция яркости, а не пятна покрова.
##
## Поэтому вершина отвечает только за БИОМ (песок, луг, подлесок, крутизна) —
## это её масштаб, десятки метров, — а мелкую фактуру поверх кладёт шейдер.
##
## ЧТО ДАЁТ ФАКТУРУ: НОРМАЛЬ, А НЕ АЛЬБЕДО. Это правило добыто снимками, и оно
## стоило нескольких заходов. Сначала здесь были мелкие октавы и выгоревшие
## пятна — вышло мыло, потому что гладкий шум при увеличении даёт разводы и
## ничего больше. Потом было тайловое зерно с размахом яркости ±45 %, помноженное
## на макро-масштаб, полосу 5-30 м и тон вершины: суммарный размах ушёл за ±60 %,
## и земля покрылась тёмными кляксами на любой дистанции — у клеточного шума
## низкие значения это ПРОМЕЖУТКИ между ячейками, и в тёмном конце они читаются
## грязью, а не травой.
##
## Работает обратная расстановка: размах альбедо держать умеренным (±29 %), а
## поверхность делать РЕЛЬЕФОМ НОРМАЛИ. Свет, отработавший по неровности, даёт
## поверхность, которой веришь, и при этом не пачкает цвет.
##
## УГОДЬЯ (покос и пашня) отсюда УДАЛЕНЫ по решению владельца — см. подробности
## во fragment(). Коротко: порогом по гладкому шуму поля не нарисовать, контур
## получается округлой кляксой, а у поля есть прямая межа.
##
## Шум пишем свой, а не берём NoiseTexture2D: нужен fwidth от самого значения,
## а текстура его не даёт.
const GROUND_SHADER := """
shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform float field_m;           // м — крупное деление, поля через дорогу
uniform float warp_m;            // м — масштаб искривления границы
uniform float warp_amp;          // м — насколько граница уводится в сторону
uniform float tone_amp;          // остаточная игра тона внутри заливки

// --- ЗЕРНО БЛИЖНЕГО ПЛАНА ----------------------------------------------------
// Пятна угодий выше считаются с периодом 90-260 м. Это масштаб общего плана, и с
// высоты человека он не даёт РОВНО НИЧЕГО: кадр заполняет один ровный зелёный,
// «земля это просто зелёное пятно». Здесь пропущенный слой — тайловое зерно.
//
// СВОИХ UV У СЕТКИ ЗЕМЛИ НЕТ (_quad_cn их не кладёт), и они не нужны: для почти
// горизонтальной поверхности проекция по мировым XZ и есть правильная развёртка.
// Тот же приём у LiteTerrain (v_tile_uv = world_pos.xz / tile_world_size).
// Полноценный трипланар здесь лишний — уклоны у нас не выше 0.32.
uniform sampler2D grain_grass : filter_linear_mipmap, repeat_enable;
uniform sampler2D grain_grass_n : filter_linear_mipmap, repeat_enable;
uniform sampler2D grain_soil : filter_linear_mipmap, repeat_enable;
uniform sampler2D grain_soil_n : filter_linear_mipmap, repeat_enable;
uniform float grass_m;           // м — период тайла травяного зерна
uniform float soil_m;            // м — период тайла грунта
uniform float detail_far;        // м — с какой дали зерно перестаёт считаться
uniform float detail_fade;       // м — ширина полосы гашения
uniform float normal_amp;        // насколько зерно правит нормаль
uniform float clump_m;           // м — средний масштаб пятен (провал 5-30 м)
uniform float clump_amp;
uniform float macro_amp;         // сила второго, крупного масштаба зерна
uniform float grain_lo;          // размах яркости зерна: сырое 0..1 -> lo..hi
uniform float grain_hi;

varying vec3 v_wpos;
varying vec3 v_wnrm;
varying float v_dist;

float hash12(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash12(i);
	float b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0));
	float d = hash12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
}

// Поворот координат между октавами — против решётчатости, которая иначе
// накапливается по осям (тот же приём, что в _fbm на стороне GDScript).
float fbm(vec2 p, int oct) {
	float s = 0.0;
	float a = 0.5;
	float n = 0.0;
	for (int k = 0; k < oct; k++) {
		s += a * vnoise(p);
		n += a;
		a *= 0.5;
		p = p * 2.03 + vec2(17.1, 9.7);
	}
	return s / n;
}

vec2 rot2(vec2 v, float c, float s) {
	return vec2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// СМЕШИВАНИЕ ПО ГЛУБИНЕ вместо mix(). Приём Мишкиниса, взят из HTerrain
// (shaders/simple4.gdshader). Обычный mix даёт мутную полосу перехода; здесь на
// каждом пикселе выигрывает та поверхность, что физически ВЫШЕ, и граница
// получается зубчатой и физичной: грунт затекает между кочками, а не
// размазывается по ним. Высоту берём из яркости самого зерна — светлое это
// поднятое.
vec4 depth_blend2(vec4 a, float ah, vec4 b, float bh, float t) {
	float d = 0.1;
	float ma = max(ah + (1.0 - t), bh + t) - d;
	float wa = max(ah + (1.0 - t) - ma, 0.0);
	float wb = max(bh + t - ma, 0.0);
	return (a * wa + b * wb) / (wa + wb);
}

// АНТИТАЙЛИНГ ДВОЙНОЙ ВЫБОРКОЙ, тоже из HTerrain (texture_antitile). Тайл
// периодом полтора метра на открытом поле читался бы клетчатой скатертью. Та же
// текстура читается второй раз повёрнутой и в другом масштабе, а переключение
// между вариантами делает искривлённый шахматный узор из sin*cos. Смешивание —
// снова по глубине, а НЕ альфой: альфа замыливает ровно ту деталь, ради которой
// всё и затевалось (это прямая цитата причины из HTerrain).
void sample_grain(sampler2D atex, sampler2D ntex, vec2 uv, out float lum, out vec2 slope) {
	float c = 0.8253;               // поворот на ~34 градуса
	float s = 0.5646;
	vec2 uv2 = rot2(uv, c, s) * 1.31;
	vec4 a0 = texture(atex, uv);
	vec4 a1 = texture(atex, uv2);
	vec3 n0 = texture(ntex, uv).rgb * 2.0 - 1.0;
	vec3 n1 = texture(ntex, uv2).rgb * 2.0 - 1.0;
	n1.xy = rot2(n1.xy, c, -s);     // нормаль поворачивается вместе с текстурой
	float t = 1.2 + sin(uv2.x * 2.0 + sin(uv.x) * 2.0)
		* cos(uv2.y * 2.0 + sin(uv.y) * 2.0);
	t = smoothstep(0.7, 1.3, t);
	lum = depth_blend2(a0, a0.r, a1, a1.r, t).r;
	slope = mix(n0.xy, n1.xy, t);
}

void vertex() {
	v_wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	v_dist = distance(v_wpos, CAMERA_POSITION_WORLD);
}

void fragment() {
	vec2 p = v_wpos.xz;
	// ИСКРИВЛЕНИЕ КООРДИНАТЫ (domain warp). Гладкий шум низкой частоты даёт
	// только округлые формы; сдвиг координаты вторым шумом ломает их в заливы и
	// мысы. Стоит две выборки. Осталось от угодий, но работает и на тоне луга.
	vec2 warp = vec2(fbm(p / warp_m, 2), fbm(p / warp_m + vec2(31.4, 7.7), 2)) * warp_amp;
	vec2 q = p + warp;
	// Одна низкая частота осталась — ею играет ТОН луга, а не отдельный покров.
	float n_field = fbm(q / field_m + vec2(53.7, 11.3), 2);

	// Цвет вершины приходит УЖЕ ЛИНЕЙНЫМ (см. _lin): в шейдере он не трогается.
	// COLOR.a — доля ЛУГА в биоме: на песке, крутизне и под лесом её нет.
	float meadow = COLOR.a;
	vec3 base = COLOR.rgb * (1.0 + tone_amp * n_field);

	// УГОДЬЯ (покос и пашня) ЗДЕСЬ БЫЛИ И УДАЛЕНЫ ПО РЕШЕНИЮ ВЛАДЕЛЬЦА.
	// Они рисовались порогом по этому же шуму: выше порога — другой цвет. Но
	// контур из fbm округлый ПО ПОСТРОЕНИЮ, а настоящая пашня сверху — парцеллы
	// с прямыми межами, привязанные к дороге и рельефу. Поэтому на средней
	// дистанции они читались не полями, а бурыми разводами, и вылечить это
	// параметрами не вышло: две попытки (снизить контраст, починить ширину межи)
	// дали лучше, но не другое. Резкая граница у кляксы делает её кляксой с
	// резкой границей.
	//
	// Находка про правильный перевод ширины порога в метры сохранена отдельно:
	// bd recall noise-threshold-edge-width. Она понадобится, если будем делать
	// парцеллы настоящим генератором, а не порогом по шуму.

	// ПРОВАЛ 5-30 М. Между зерном (полтора метра) и угодьями (девяносто) не было
	// ничего, а это как раз масштаб вытоптанных плешин и куртин — то, чем земля
	// перестаёт быть заливкой на средней дистанции.
	base *= 1.0 + clump_amp * fbm(q / clump_m, 2);

	// ВТОРОЙ МАСШТАБ ТОГО ЖЕ ТАЙЛА — «макровариация». Мелкое зерно живёт только
	// вблизи: при периоде полтора метра уже с полусотни метров тексель мельче
	// пикселя, мип усредняет тайл в его среднее, и земля снова становится ровной
	// заливкой. Ровно это и было видно на первом снимке. Тот же тайл, растянутый
	// в семь раз, мипами не съедается и держит пятнистость там, где мелкое зерно
	// уже сдалось. Стоит одну выборку и не требует ни второй текстуры, ни ветвления.
	float macro = grain_lo + (grain_hi - grain_lo) * texture(grain_grass, p / (grass_m * 7.0)).r;
	base *= mix(1.0, macro, macro_amp);

	vec3 wn = v_wnrm;

	// ДАЛЬНИЙ ПЛАН ЗЕРНО НЕ СЧИТАЕТ (приём HTerrain, globalmap_factor). За
	// detail_far тайл мельче пикселя, и его выборка даёт уже не деталь, а
	// мерцание; заодно это снимает восемь выборок текстур с каждого дальнего
	// пикселя, а дальних пикселей в кадре диспетчера большинство.
	float far = clamp((v_dist - detail_far) / detail_fade, 0.0, 1.0);
	far *= far;
	if (far < 1.0) {
		float g_lum;
		vec2 g_slope;
		sample_grain(grain_grass, grain_grass_n, p / grass_m, g_lum, g_slope);
		float s_lum;
		vec2 s_slope;
		sample_grain(grain_soil, grain_soil_n, p / soil_m, s_lum, s_slope);
		// Где земля обнажена — там зерно грунта, где луг — травяное. Небиомные
		// места (крутизна, подлесок, песок) идут за грунт.
		float soil_w = clamp((1.0 - meadow) * 0.6, 0.0, 1.0);
		vec4 det = depth_blend2(vec4(g_lum), g_lum, vec4(s_lum), s_lum, soil_w);
		vec2 slope = mix(g_slope, s_slope, soil_w);
		float k = 1.0 - far;
		base *= mix(1.0, grain_lo + (grain_hi - grain_lo) * det.r, k);
		// Нормаль правится В МИРОВЫХ ОСЯХ, без NORMAL_MAP: у сетки земли нет ни
		// UV, ни касательных, и NORMAL_MAP просто не на чем строить. Тот же
		// приём у HTerrain — подмешать наклон зерна в X и Z, Y оставить.
		wn = normalize(wn + vec3(slope.x, 0.0, -slope.y) * (normal_amp * k));
	}

	ALBEDO = base;
	// NORMAL в фрагменте задаётся В ВИДОВЫХ КООРДИНАТАХ — отсюда VIEW_MATRIX.
	NORMAL = (VIEW_MATRIX * vec4(wn, 0.0)).xyz;
	// Матово и без блика: стилизация держится силуэтом и тоном, а глянец на
	// земле только спорит с ними и ловит алиасинг на дальних скатах.
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}
"""

## --- зерно земли: текстуры считаются, а не читаются с диска -------------------
## PNG здесь не нужен: текстура — это массив чисел на видеокарте, а PNG всего лишь
## способ их туда доставить. Noise.get_seamless_image() делает тот же массив на
## старте. Проект так уже живёт: щебень (_stone_texture) и дерево шпалы
## (_wood_texture) считаются ровно так же.
##
## Клеточный шум, а не перлин, и по той же причине, что у щебня: у перлина по
## построению нет высоких частот, и вблизи он даёт разводы, а не фактуру. Разница
## между двумя покровами — в ТИПЕ ячейки, а не в цвете поверх общего шума:
##   * трава  — F1, расстояние до ближайшего центра: купола, то есть кочки;
##   * грунт  — F2-F1, как у щебня: гранёные комья с швом между ними.
const GRAIN_TILE := 512
const SOIL_CELL_PX := 22.0       # px — комья грунта
const SOIL_TILE_M := 2.1         # м — период тайла грунта

## --- ДЕРНИНА: ТАЙЛ ИЗ НАСТОЯЩИХ ЛИСТЬЕВ --------------------------------------
## Травяное зерно здесь считалось КЛЕТОЧНЫМ ШУМОМ — теми же ячейками, что щебень,
## только крупнее. Ячейка Ворлея это купол, «кочка»; из куполов получается мятая
## резина, а не трава. Владелец показал два снимка газона сверху, и на них видно
## главное: трава на поверхности читается ПЕРЕПЛЁТОМ УЗКИХ ЛИСТЬЕВ, лежащих в
## разные стороны, с тёмными провалами между ними. Ни один изотропный шум этого
## не даёт по построению — у листа есть длина и направление, у шума нет.
##
## Отсюда прямое следствие для инстансов: пока поверхность не была травой, весь
## груз лежал на пучках, и их пришлось раздуть до размера куста, чтобы хоть
## что-то читалось. Дернина в текстуре снимает этот груз — пучки возвращаются к
## своему настоящему размеру и работают силуэтом на просвет, а не покровом.
##
## Тайл рисуется В БАЙТОВЫЙ БУФЕР, а не через set_pixel: листьев тысячи, у
## каждого десятки шагов, и на вызовах set_pixel это секунды на ровном месте.
##
## ЛИСТЬЯ ЛОЖАТСЯ ПРЯДЯМИ, А НЕ РОЗЕТКАМИ. Это правка второго захода, и она
## добыта не рассуждением, а выгрузкой самого тайла в PNG (tools/tile_dump.gd):
## на нём было ровно то, что владелец назвал убогой травой, — поле светлых
## ЗВЁЗДОЧЕК на тёмном фоне, «брокколи».
##
## Причина — одна строка предыдущего захода: лист смотрел НАРУЖУ куртины. Пучок
## листьев, расходящихся лучами из общей точки, это одуванчик или чертополох, а
## не дернина. Сверху газон и луг выглядят иначе: у листьев есть МЕСТНОЕ ОБЩЕЕ
## НАПРАВЛЕНИЕ — прядь причёсана в одну сторону, соседняя в другую, — и переплёт
## этих прядей, а не точечные розетки, и есть рисунок травы. Причина физическая:
## лист травы длинный и полёгший, он ложится туда, куда его положили ветер, дождь
## и соседи, а соседи рядом полегли так же.
##
## Отсюда конструкция: гладкое ПЕРИОДИЧЕСКОЕ поле направлений по тайлу
## (_tile_wave), лист берёт направление в своей точке плюс разброс, и листьев
## столько, чтобы фон почти не проглядывал. Розеточного центра не возникает нигде.
##
## Мип от этого не страдает, а выигрывает: пятно у пряди крупное (треть тайла,
## то есть полметра) и переживает усреднение, а между прядями идёт тёмный
## провал — то же, что видно на натурных снимках с высоты.
const TURF_TEX := 384            # px — сторона тайла дернины
const TURF_TILE_M := 1.5         # м — период тайла в мире
const TURF_BLADES := 9000        # листьев на тайл: покров сплошной, а не крапом
const TURF_LEN_MIN := 0.042      # доли стороны тайла — лист 6 см
const TURF_LEN_MAX := 0.105      # 16 см
const TURF_W_MIN := 1.3          # px — лист 5 мм
const TURF_W_MAX := 3.0          # px — 12 мм
const TURF_COMB := 3             # целых волн на тайл в поле направлений: прядь ~50 см
const TURF_JITTER := 0.95        # рад — разброс листа вокруг направления пряди
const TURF_BG := 0.14            # провал между листьями: тень, а не почва

## SEAMLESS ЗДЕСЬ ВКЛЮЧЁН, в отличие от щебня. У щебня он вреден (кросс-фейд
## тайла с самим собой смазывает границу зерна), и там это сходит с рук: полоса
## балласта узкая, шов не виден. Земля — открытое поле, и шов через каждые
## полтора метра сеткой по всему кадру куда хуже, чем слегка смягчённая ячейка.
## Остаток шва добивает антитайлинг в шейдере.
##
## ГЕНЕРАЦИЯ СИНХРОННАЯ, И ЭТО НЕ ПРИДИРКА. Первый заход строил зерно через
## NoiseTexture2D — и на снимке не появилось РОВНО НИЧЕГО при размахе яркости
## ±45 %. Причина: NoiseTexture2D считает картинку в ФОНОВОМ ПОТОКЕ, и до её
## готовности сэмплер отдаёт белое. Проверено отдельно (tools/tex_check.gd):
## get_image() сразу после создания возвращает null. Белое зерно — это множитель
## 1.0, то есть заливка без единого следа: дефект выглядит как «шейдер не
## работает», а работает он идеально, просто по пустой текстуре.
func _grain_image(seed_v: int, cell_px: float, clumpy: bool) -> Image:
	var noise := FastNoiseLite.new()
	noise.seed = seed_v
	noise.noise_type = FastNoiseLite.TYPE_CELLULAR
	noise.cellular_return_type = FastNoiseLite.RETURN_DISTANCE if clumpy \
		else FastNoiseLite.RETURN_DISTANCE2_SUB
	noise.cellular_distance_function = FastNoiseLite.DISTANCE_EUCLIDEAN
	noise.cellular_jitter = 1.0
	noise.frequency = 1.0 / cell_px
	# Две октавы: крупная даёт кочку, вторая — крошку на ней. Одна октава читается
	# правильным горошком, которого в натуре не бывает.
	noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	noise.fractal_octaves = 2
	var img := noise.get_seamless_image(GRAIN_TILE, GRAIN_TILE)
	img.convert(Image.FORMAT_RGB8)
	return img

## ПЕРИОДИЧЕСКОЕ ГЛАДКОЕ ПОЛЕ ПО ТАЙЛУ: сумма плоских волн с ЦЕЛЫМИ волновыми
## векторами. Целочисленность — это и есть условие бесшовности: на краю тайла
## фаза набегает ровно на 2π и поле смыкается само с собой. Обычный FastNoiseLite
## здесь не годится — он периодичным не бывает, и поле направлений дало бы шов
## через каждые полтора метра по всему полю.
##
## kmax задаёт, сколько волн укладывается в тайл: при 3 прядь выходит около
## полуметра — тот масштаб, который переживает мип и виден с высоты станции.
func _tile_wave(u: float, v: float, salt: int, waves: int, kmax: int) -> float:
	var sum := 0.0
	for k in waves:
		var kx := int(_hash01(k, salt, 41) * float(2 * kmax + 1)) - kmax
		var ky := int(_hash01(k, salt, 42) * float(2 * kmax + 1)) - kmax
		if kx == 0 and ky == 0:
			kx = 1
		sum += sin(TAU * (float(kx) * u + float(ky) * v) + _hash01(k, salt, 43) * TAU)
	return sum / sqrt(float(waves))

## Тайл дернины: тысячи узких листьев, причёсанных прядями. Лист — мазок с
## сужением и просветлением к кончику; направление берётся из поля прядей в точке
## корня плюс разброс TURF_JITTER.
##
## Порядок рисования — обычный, поверх: последний лист закрывает предыдущий.
## Именно так и выглядит переплёт, а осреднять их (максимумом, полупрозрачностью)
## значит вернуть то самое мыло, от которого ушли.
##
## Бесшовность здесь ПО ПОСТРОЕНИЮ, а не кросс-фейдом: и координата пишется по
## модулю стороны тайла, и поле направлений периодично. Кросс-фейд
## (get_seamless_image) смазал бы ровно то, ради чего всё рисуется, — как уже
## вышло со щебнем.
func _turf_image() -> Image:
	var s := TURF_TEX
	var buf := PackedByteArray()
	buf.resize(s * s)
	buf.fill(int(TURF_BG * 255.0))
	for b in TURF_BLADES:
		var x0 := _hash01(b, 31, 1) * s
		var y0 := _hash01(b, 31, 2) * s
		var u := x0 / float(s)
		var v := y0 / float(s)
		# Направление пряди в точке корня; жребий разводит соседние листья, но не
		# настолько, чтобы прядь перестала читаться причёсанной.
		var ang := PI * _tile_wave(u, v, 61, 5, TURF_COMB) \
			+ (_hash01(b, 32, 3) - 0.5) * 2.0 * TURF_JITTER
		# Тон пряди — то, что переживает мип: одна полегла к свету и светлее,
		# соседняя от света и темнее. Второе поле, со своим набором волн.
		#
		# АМПЛИТУДА ЗДЕСЬ МАЛЕНЬКАЯ, А ЧАСТОТА НЕ НИЖЕ ПРЯДЕЙ — НАРОЧНО. Первый
		# заход дал этому полю размах 0.40..1.06 при kmax = 2, и на снимке с
		# тридцати метров вылезла клетка: тайл повторяется через полтора метра, и
		# ЛЮБАЯ низкая частота внутри него становится решёткой на весь кадр.
		# Антитайлинг в шейдере ломает рисунок, но не сетку пятен — он сам
		# переключается узором того же масштаба. Пятна крупнее тайла обязан давать
		# не тайл, а шейдер (clump_m = 6 м), у него периода нет вовсе.
		var patch: float = 0.5 + 0.5 * _tile_wave(u, v, 71, 5, TURF_COMB)
		var tone: float = clampf((0.66 + 0.26 * patch) * (0.72 + 0.56 * _hash01(b, 32, 6)), 0.0, 1.0)
		var ln: float = lerpf(TURF_LEN_MIN, TURF_LEN_MAX, _hash01(b, 32, 4)) * s
		var w: float = lerpf(TURF_W_MIN, TURF_W_MAX, _hash01(b, 32, 5))
		var dx := cos(ang)
		var dy := sin(ang)
		var steps := int(ln / 1.2) + 1
		for st in steps + 1:
			var t := float(st) / float(steps)
			var px0 := x0 + dx * ln * t
			var py0 := y0 + dy * ln * t
			# Лист сужается и светлеет к кончику: у корня он в тени соседей.
			var hw := w * (1.0 - t * t) * 0.5 + 0.4
			var val := int(clampf(tone * lerpf(0.55, 1.18, t), 0.0, 1.0) * 255.0)
			var k := -hw
			while k <= hw:
				var px := int(round(px0 - dy * k)) % s
				var py := int(round(py0 + dx * k)) % s
				buf[((py + s) % s) * s + (px + s) % s] = val
				k += 1.0
	var img := Image.create_from_data(s, s, false, Image.FORMAT_L8, buf)
	img.convert(Image.FORMAT_RGB8)
	return img

func _grain_albedo(seed_v: int, cell_px: float, clumpy: bool) -> ImageTexture:
	var img := _grain_image(seed_v, cell_px, clumpy)
	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)

## Нормаль строится ИЗ ТОЙ ЖЕ карты высот, что и яркость. Это приближение и оно
## честно названо: настоящий фотоскан несёт нормаль отдельным каналом, снятым с
## реальной поверхности, а «яркое значит поднятое» верно не всегда. Для зерна
## земли верно достаточно.
func _grain_normal(seed_v: int, cell_px: float, clumpy: bool, strength: float) -> ImageTexture:
	var img := _grain_image(seed_v, cell_px, clumpy)
	img.bump_map_to_normal_map(strength)
	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)

func _mat_ground() -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = GROUND_SHADER
	var mat := ShaderMaterial.new()
	mat.shader = sh
	# Дернина: один рисунок в двух ролях — яркостью листа и его же нормалью.
	# Считается ОДИН раз и копируется: рисование тайла это сотни тысяч записей.
	var turf := _turf_image()
	var turf_n := turf.duplicate(true) as Image
	turf.generate_mipmaps()
	turf_n.bump_map_to_normal_map(2.6)
	turf_n.generate_mipmaps()
	mat.set_shader_parameter("grain_grass", ImageTexture.create_from_image(turf))
	mat.set_shader_parameter("grain_grass_n", ImageTexture.create_from_image(turf_n))
	mat.set_shader_parameter("grain_soil", _grain_albedo(0x501D, SOIL_CELL_PX, false))
	mat.set_shader_parameter("grain_soil_n", _grain_normal(0x501D, SOIL_CELL_PX, false, 3.2))
	# ФАКТУРУ ДАЁТ НОРМАЛЬ, А НЕ КАЧЕЛИ ЯРКОСТИ. Первый заход выкрутил размах
	# альбедо до 0.40..1.72 — и вблизи земля покрылась тёмными кляксами: у
	# клеточного шума низкие значения это ПРОМЕЖУТКИ между ячейками, и в тёмном
	# конце они читаются не травой, а грязью. Плюс эти качели перемножались с
	# макро-масштабом, полосой 5-30 м и тоном вершины — пять слоёв модуляции
	# яркости подряд давали суммарный размах за ±60 %, отсюда пятна на ЛЮБОЙ
	# дистанции.
	#
	# Размах альбедо убран до ±29 %, а взамен поднята правка нормали: рельеф,
	# отработанный светом, даёт поверхность, которой веришь, и при этом не пачкает
	# цвет. Это общее правило, а не подгонка под кадр.
	# Среднее у клеточного шума около 0.45 (замерено tools/tex_check.gd), поэтому
	# lo/hi подобраны так, чтобы СРЕДНЯЯ яркость зерна была единицей: иначе зерно
	# не текстурирует землю, а просто её притемняет или высветляет.
	mat.set_shader_parameter("grain_lo", 0.62)
	mat.set_shader_parameter("grain_hi", 1.42)
	mat.set_shader_parameter("grass_m", TURF_TILE_M)
	mat.set_shader_parameter("soil_m", SOIL_TILE_M)
	# ДАЛЬ ОТОДВИНУТА: вид диспетчера смотрит на землю с полутора сотен метров, и
	# при прежних 90 м дернина гасла ровно там, где на неё и смотрят.
	mat.set_shader_parameter("detail_far", 150.0)
	mat.set_shader_parameter("detail_fade", 90.0)
	# ОБЪЁМ ДАЁТ НОРМАЛЬ. Сверху вертикальные квады пучков не видны вовсе (у них
	# нет площади в плане), и вся глубина поверхности держится на этом числе.
	mat.set_shader_parameter("normal_amp", 2.4)
	# Провал масштабов между куртиной (15 см в тайле) и угодьями (сотни метров)
	# закрывают эти два: 6 м — плешины и вытоптанные пятна, они же главное, что
	# видно на земле с высоты станции.
	mat.set_shader_parameter("clump_m", 6.0)
	mat.set_shader_parameter("clump_amp", 0.14)
	mat.set_shader_parameter("macro_amp", 0.16)
	mat.set_shader_parameter("field_m", 260.0)
	mat.set_shader_parameter("warp_m", 34.0)
	mat.set_shader_parameter("warp_amp", 26.0)
	mat.set_shader_parameter("tone_amp", 0.05)
	return mat

## ЮБКА: мир не должен обрываться. Каждая граничная вершина поля высот тянется
## наружу на SKIRT_FAR со своей отметкой и лёгким уклоном вниз — обрыва нет ни
## на одной высоте, а дымка делает остальное. Раньше за краем открывалась нижняя
## половина процедурного неба: ровная серая стена во весь экран.
func _add_skirt(h: Array, nx: int, nz: int) -> void:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Юбка почти в цвет краевого луга: если её затемнить, на горизонте
	# появляется чёрная полоса — то есть тот же обрыв, только другого цвета.
	var far_c := C_MEADOW_B.lerp(C_UNDER, 0.2)
	for j in nz - 1:
		var z0 := W_Z0 + j * W_STEP
		var z1 := z0 + W_STEP
		var wl: PackedFloat32Array = h[0]
		var wr: PackedFloat32Array = h[nx - 1]
		_skirt_quad(tool, Vector3(W_X0, wl[j], z0), Vector3(W_X0, wl[j + 1], z1),
			Vector3(-SKIRT_FAR, 0.0, 0.0), far_c)
		_skirt_quad(tool, Vector3(W_X1, wr[j], z0), Vector3(W_X1, wr[j + 1], z1),
			Vector3(SKIRT_FAR, 0.0, 0.0), far_c)
	for i in nx - 1:
		var x0 := W_X0 + i * W_STEP
		var x1 := x0 + W_STEP
		var ca: PackedFloat32Array = h[i]
		var cb: PackedFloat32Array = h[i + 1]
		_skirt_quad(tool, Vector3(x0, ca[0], W_Z0), Vector3(x1, cb[0], W_Z0),
			Vector3(0.0, 0.0, -SKIRT_FAR), far_c)
		_skirt_quad(tool, Vector3(x0, ca[nz - 1], W_Z1), Vector3(x1, cb[nz - 1], W_Z1),
			Vector3(0.0, 0.0, SKIRT_FAR), far_c)
	# Углы: вылеты двух соседних сторон оставляют клин в 90 градусов.
	var corners := [
		[Vector3(W_X0, float(h[0][0]), W_Z0), Vector3(-SKIRT_FAR, 0, 0), Vector3(0, 0, -SKIRT_FAR)],
		[Vector3(W_X1, float(h[nx - 1][0]), W_Z0), Vector3(SKIRT_FAR, 0, 0), Vector3(0, 0, -SKIRT_FAR)],
		[Vector3(W_X0, float(h[0][nz - 1]), W_Z1), Vector3(-SKIRT_FAR, 0, 0), Vector3(0, 0, SKIRT_FAR)],
		[Vector3(W_X1, float(h[nx - 1][nz - 1]), W_Z1), Vector3(SKIRT_FAR, 0, 0), Vector3(0, 0, SKIRT_FAR)],
	]
	for c in corners:
		var p: Vector3 = c[0]
		var a: Vector3 = c[1]
		var b: Vector3 = c[2]
		var drop := Vector3(0.0, -SKIRT_DROP, 0.0)
		_quad_cn(tool, p, p + a + drop, p + a + b + drop, p + b + drop,
			Vector3.UP, Vector3.UP, Vector3.UP, Vector3.UP,
			far_c, far_c, far_c, far_c)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(1, 1, 1)
	mat.vertex_color_use_as_albedo = true
	mat.roughness = 1.0
	# Обмотка юбки зависит от стороны; вместо четырёх разборов знака — двусторонний
	# материал: юбку всё равно видно только сверху и только сквозь дымку.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	_commit(tool, mat)

func _skirt_quad(tool: SurfaceTool, a: Vector3, b: Vector3, out: Vector3, c: Color) -> void:
	var drop := Vector3(0.0, -SKIRT_DROP, 0.0)
	_quad_cn(tool, a, b, b + out + drop, a + out + drop,
		Vector3.UP, Vector3.UP, Vector3.UP, Vector3.UP, c, c, c, c)

## Отметка земли в произвольной точке — билинейно по кэшу сетки. За пределами
## сетки возвращает край: там всё равно юбка.
func _height_at(x: float, z: float) -> float:
	if _h_grid.is_empty():
		return _ground_worked(x, z)
	var fi: float = clampf((x - W_X0) / W_STEP, 0.0, float(_h_nx - 1))
	var fj: float = clampf((z - W_Z0) / W_STEP, 0.0, float(_h_nz - 1))
	var i0 := int(fi)
	var j0 := int(fj)
	var i1: int = mini(i0 + 1, _h_nx - 1)
	var j1: int = mini(j0 + 1, _h_nz - 1)
	var tx := fi - i0
	var tz := fj - j0
	var c0: PackedFloat32Array = _h_grid[i0]
	var c1: PackedFloat32Array = _h_grid[i1]
	return lerpf(lerpf(c0[j0], c1[j0], tx), lerpf(c0[j1], c1[j1], tx), tz)

## Нормаль поля высот в узле (i, j): центральная разность по обеим осям, на краю
## — односторонняя. Направлена наружу (вверх) — это та же сторона, что кладёт
## _quad_c через NORMAL_SIGN.
func _terrain_normal(h: Array, nx: int, nz: int, i: int, j: int) -> Vector3:
	var i0: int = maxi(i - 1, 0)
	var i1: int = mini(i + 1, nx - 1)
	var j0: int = maxi(j - 1, 0)
	var j1: int = mini(j + 1, nz - 1)
	var hx0: PackedFloat32Array = h[i0]
	var hx1: PackedFloat32Array = h[i1]
	var hj: PackedFloat32Array = h[i]
	var dhdx := (hx1[j] - hx0[j]) / float(i1 - i0) / W_STEP
	var dhdz := (hj[j1] - hj[j0]) / float(j1 - j0) / W_STEP
	return Vector3(-dhdx, 1.0, -dhdz).normalized()

## Цвет покрова в точке — БИОМ, то есть масштаб в десятки метров и крупнее.
##
## АЛЬФА ЗДЕСЬ — НЕ ПРОЗРАЧНОСТЬ, а доля луга: шейдер покрова кладёт угодья
## (покос, пашню) только туда, где луг, и не лезет ими на песок, крутизну и
## подлесок. Прозрачностью её никто не прочтёт — у покрова непрозрачный
## render_mode, а земля рисуется одним материалом.
func _cover(p: Vector3, slope: float) -> Color:
	# ПЕСОК — ТОЛЬКО У ВОДЫ, а не на всякой низкой отметке.
	var wet: float = clampf((WATER_Y + SAND_BAND + 2.4 - p.y) / 2.4, 0.0, 1.0) * _beach(p)
	if wet >= 0.999:
		var sand := C_SAND
		sand.a = 0.0
		return sand
	# ТОЛЬКО КРУПНЫЙ МАСШТАБ: вершины стоят через W_STEP (5 м), и всё мельче 10 м
	# здесь невыразимо. Здесь стоял второй член get_noise_2d(x*7, z*7) с периодом
	# ~14 м «против ощущения крашеной пластмассы» — он давал не деталь, а шум на
	# границе Найквиста, и как раз пластмассу и оставлял. Ближний план теперь за
	# шейдером покрова (GROUND_SHADER), там цвет считается на пиксель.
	var tone: float = clampf(0.5 + 0.5 * _n_tone.get_noise_2d(p.x, p.z), 0.0, 1.0)
	var c := C_MEADOW_B.lerp(C_MEADOW_A, tone)
	# ЗАТЕМНЕНИЕ ПОД ЛЕСОМ — 0.45, А НЕ 0.8. Подлесок должен читаться там, где над
	# ним стоят деревья, а маска леса мягкая и широкая (период ~300 м): при 0.8
	# она красила тёмным ОТКРЫТОЕ поле на сотни метров вокруг массива, и с
	# середины дистанции это выглядело тенью от несуществующей тучи. Деревья при
	# этом сажаются по вероятностной кривой от той же маски, то есть тёмная земля
	# заходила далеко за последнее дерево.
	var forest: float = clampf((_n_forest.get_noise_2d(p.x, p.z) - 0.02) * 6.0, 0.0, 1.0)
	c = c.lerp(C_UNDER, forest * FOREST_TINT)
	var scarp := 0.0
	if slope > SCARP_SLOPE:
		scarp = clampf((slope - SCARP_SLOPE) * 2.2, 0.0, 0.9)
		c = c.lerp(C_SCARP, scarp)
	# ПЛЕШИНЫ: где покров не сомкнулся, видна почва, и она НЕ ЗЕЛЁНАЯ. Под пологом
	# леса плешина слабее — там подстилка, а не выбитая земля.
	var bare := (1.0 - _veg_density(p.x, p.z)) * BARE_TINT * (1.0 - forest * 0.5)
	c = c.lerp(C_SOIL, bare)
	# Полоса песка растворяется вверх, а не режется линией (wet посчитан выше).
	c = c.lerp(C_SAND, wet * 0.85)
	# Доля луга падает вместе с покровом: шейдер берёт на плешине зерно ГРУНТА, а
	# не травы, и голое место отличается от дернины не только цветом, но фактурой.
	c.a = (1.0 - maxf(maxf(forest * FOREST_TINT, scarp), wet * 0.85)) * (1.0 - bare)
	return c

## БЕРЕГ: насколько точка вообще может быть пляжем. Проверка песка была чисто по
## высоте (p.y < WATER_Y + SAND_BAND), и пока низины срезались клэмпом ровно в
## ноль, это сходило с рук — под порог попадала либо вся плоскость, либо ничего.
## После правки вертикального бюджета земля пошла настоящими отметками, часть
## станции легла около нуля, и весь её луг ушёл в бежевый: пляж в четырёхстах
## метрах от воды. Вода у нас одна — река, поэтому и пояс песка привязан к её
## руслу, а не к отметке над уровнем моря.
func _beach(p: Vector3) -> float:
	var d := absf(p.z - _river_z(p.x))
	return clampf((RIVER_HALF + RIVER_BANK * 1.4 - d) / (RIVER_BANK * 0.7), 0.0, 1.0)

## --- вода -------------------------------------------------------------------
## Лента по оси реки, шире русла: края уходят в берег и стыка не видно.
func _add_water() -> void:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var half := RIVER_HALF + RIVER_BANK * 0.55
	var x := W_X0
	while x < W_X1:
		var x2: float = minf(x + 12.0, W_X1)
		var za := _river_z(x)
		var zb := _river_z(x2)
		_quad_c(tool,
			Vector3(x, WATER_Y, za - half), Vector3(x2, WATER_Y, zb - half),
			Vector3(x2, WATER_Y, zb + half), Vector3(x, WATER_Y, za + half),
			C_WATER, C_WATER, C_WATER, C_WATER)
		x = x2
	var mat := StandardMaterial3D.new()
	mat.albedo_color = C_WATER
	mat.roughness = 0.06
	mat.metallic = 0.25
	_commit(tool, mat)

## --- лес --------------------------------------------------------------------
## Ячейки вдоль оси пути, куда деревья не сажаются. Считается один раз по
## осевым, собранным родителем: перебирать все осевые для каждой посадки — это
## миллионы сравнений на ровном месте.
func _build_corridor_mask() -> void:
	_corridor.clear()
	var r := int(ceil(TREE_CLEAR / TREE_STEP))
	for p in _cl_pts:
		var ci := int(floor(p.x / TREE_STEP))
		var cj := int(floor(p.z / TREE_STEP))
		for di in range(-r, r + 1):
			for dj in range(-r, r + 1):
				if di * di + dj * dj <= r * r:
					_corridor[(ci + di) * 100003 + (cj + dj)] = true

	var rv := int(ceil(VILLAGE_CLEAR / TREE_STEP))
	for v in VILLAGE:
		var vi := int(floor(v.x / TREE_STEP))
		var vj := int(floor(v.y / TREE_STEP))
		for di in range(-rv, rv + 1):
			for dj in range(-rv, rv + 1):
				if di * di + dj * dj <= rv * rv:
					_corridor[(vi + di) * 100003 + (vj + dj)] = true

func _in_corridor(x: float, z: float) -> bool:
	return _corridor.has(int(floor(x / TREE_STEP)) * 100003 + int(floor(z / TREE_STEP)))

## ТРИ ПОРОДЫ И ПОДЛЕСОК, А НЕ ОДИН КОНУС НА ВСЁ.
##
## 52 тысячи одинаковых конусов глаз читает не лесом, а ковром: силуэт
## повторяется, и массив превращается в текстуру. Стилизация держится силуэтом,
## поэтому здесь он и правится.
##
## Порода выбирается КРУПНЫМ шумом, а не жребием на каждое дерево. Жребий даёт
## соль с перцем — равномерную смесь, которой в натуре не бывает; крупный шум
## даёт рощи: ельник, за ним березняк. Период ~180 м, то есть роща занимает
## заметную часть кадра диспетчера, а не мельтешит.
##
## Подлесок кромки отсюда УЕХАЛ в _add_bushes: кусты нужны не только на границе
## массива, но и по всему лугу, а два места посадки на один куст — это два места,
## где его настройки разъедутся.
func _add_forest() -> void:
	var xf := [[], [], []]        # по породам: ель узкая, ель раскидистая, лиственное
	var cl := [[], [], []]
	var i := W_X0
	while i < W_X1:
		var j := W_Z0
		while j < W_Z1:
			var x := i + _rng.randf_range(-2.0, 2.0) * (TREE_STEP * 0.4)
			var z := j + _rng.randf_range(-2.0, 2.0) * (TREE_STEP * 0.4)
			j += TREE_STEP
			var mask := _n_forest.get_noise_2d(x, z)
			# Массив леса плюс редкие одиночки в поле — иначе граница массива
			# читается стеной.
			var p: float = clampf((mask - 0.02) * 5.0, 0.0, 0.96)
			if mask <= 0.02:
				p = 0.012
			if _rng.randf() > p:
				continue
			if _in_corridor(x, z):
				continue
			var y := _height_at(x, z)
			if y < WATER_Y + 2.2:
				continue
			var slope := absf(_height_at(x + 3.0, z) - y) + absf(_height_at(x, z + 3.0) - y)
			if slope / 3.0 > TREE_SLOPE_MAX:
				continue
			# Небольшой жребий поверх шума — чтобы граница рощи не резалась линией.
			var s: float = _n_species.get_noise_2d(x, z) + _rng.randf_range(-0.12, 0.12)
			var kind := 0
			if s > 0.22:
				kind = 2
			elif s > -0.18:
				kind = 1
			var hgt := _rng.randf_range(TREE_H_MIN, TREE_H_MAX)
			if kind == 2:
				hgt *= 0.85     # лиственные в этих широтах ниже ели
			var t := Transform3D(Basis().rotated(Vector3.UP, _rng.randf() * TAU), Vector3(x, y, z))
			t.basis = t.basis.scaled(Vector3.ONE * (hgt / TREE_MESH_H))
			xf[kind].append(t)
			var base: Color = C_TREE_LEAF if kind == 2 else C_TREE
			cl[kind].append(_lin(base * _rng.randf_range(0.80, 1.25)))
		i += TREE_STEP
	_add_instances(xf[0], cl[0], _tree_mesh_spruce(0.78), 0.95)
	_add_instances(xf[1], cl[1], _tree_mesh_spruce(1.24), 0.95)
	_add_instances(xf[2], cl[2], _tree_mesh_broadleaf(), 0.92)
	print("WORLD: деревьев %d/%d/%d" % [xf[0].size(), xf[1].size(), xf[2].size()])

## --- кусты ------------------------------------------------------------------
## КУСТЫ СТОЯТ ПО ВСЕЙ КАРТЕ, а не только по кромке массива. На среднем плане они
## и есть та деталь, которой не хватало: с двухсот метров трава уже не читается
## (её пучок мельче пикселя), а куст ещё читается — и открытый луг перестаёт быть
## заливкой между лесом и путём.
##
## Заросли берутся КРУПНЫМ шумом в квадрате: квадрат давит середину, поэтому
## куртина получается плотной, а между куртинами кустов нет вовсе. Равномерный
## жребий по полю дал бы «соль с перцем» — ровно то, чего в натуре не бывает.
const BUSH_STEP := 5.5           # м — шаг сетки посадки
const BUSH_CLEAR := 6.5          # м — от оси пути кусты отступают (там балласт)
const BUSH_FIELD := 0.34         # доля занятых мест в самой густой заросли
const BUSH_LOW_SHARE := 0.42     # доля низких раскидистых
const BUSH_LOW_MESH_H := 1.3     # м — высота эталонного низкого куста

func _add_bushes() -> void:
	var ban := _track_ban(BUSH_CLEAR, 1.0)
	var xf := [[], []]
	var cl := [[], []]
	var x := W_X0
	while x < W_X1:
		var z := W_Z0
		while z < W_Z1:
			var px := x + _rng.randf_range(-0.45, 0.45) * BUSH_STEP
			var pz := z + _rng.randf_range(-0.45, 0.45) * BUSH_STEP
			z += BUSH_STEP
			var forest := _forest_mask(px, pz)
			var clump: float = clampf(0.5 + 0.5 * _n_bush.get_noise_2d(px, pz), 0.0, 1.0)
			var p: float = BUSH_FIELD * clump * clump * (1.0 - forest * 0.75)
			# Кромка массива: подлесок гуще. Без него граница леса — рез, высокие
			# деревья кончаются, и сразу луг.
			if absf(_n_forest.get_noise_2d(px, pz) - 0.02) < BUSH_BAND:
				p = maxf(p, BUSH_CHANCE)
			# На голой почве не растёт ничего — это та же маска, что красит её в грунт.
			p *= _veg_density(px, pz)
			if _rng.randf() > p:
				continue
			if ban.has(_cell_key(px, pz, 1.0)):
				continue
			var y := _height_at(px, pz)
			if y < WATER_Y + 1.2:
				continue
			var kind := 1 if _rng.randf() < BUSH_LOW_SHARE else 0
			var hb := _rng.randf_range(BUSH_H_MIN, BUSH_H_MAX)
			var mesh_h := BUSH_MESH_H
			if kind == 1:
				hb *= 0.55
				mesh_h = BUSH_LOW_MESH_H
			var t := Transform3D(Basis().rotated(Vector3.UP, _rng.randf() * TAU),
				Vector3(px, y, pz))
			t.basis = t.basis.scaled(Vector3.ONE * (hb / mesh_h))
			xf[kind].append(t)
			# Кусты у воды и на сухих местах разного тона — оттенок ведёт та же
			# сомкнутость покрова, что и трава рядом.
			var base := C_BUSH.lerp(C_BUSH_DRY, clampf(1.2 - _veg_density(px, pz), 0.0, 1.0))
			cl[kind].append(_lin(base * _rng.randf_range(0.78, 1.28)))
		x += BUSH_STEP
	_add_instances(xf[0], cl[0], _bush_mesh(), 0.95)
	_add_instances(xf[1], cl[1], _bush_mesh_low(), 0.95)
	print("WORLD: кустов %d + %d" % [xf[0].size(), xf[1].size()])

## --- трава ------------------------------------------------------------------
## ВБЛИЗИ ЗЕМЛЮ СПАСАЕТ ТОЛЬКО ГЕОМЕТРИЯ. Шейдер покрова даёт цвет и пятна, но с
## высоты человека земля обязана иметь ОБЪЁМ: силуэт, параллакс, тень на себя.
## Ни одна процедурная краска этого не заменяет — это то, на чём мы трижды
## упёрлись в «мыло».
##
## ТРАВА РАСТЁТ ПО ВСЕЙ ЗЕМЛЕ, А НЕ ЛЕНТОЙ ВДОЛЬ ПУТИ.
##
## Здесь стояла полоса ±7 м от осевой — «смотрят на путь, трава нужна там». На
## снимке это читалось газоном, который посадили железнодорожники: две зелёные
## обочины на ровном зелёном поле, и граница полосы отвода видна метр в метр.
## Трава — фактура ЗЕМЛИ, у неё нет причин кончаться там, где кончается отвод.
##
## Но карта 1920x1540 м: сплошной покров на неё — под десять миллионов пучков.
## Поэтому посадка идёт ВОКРУГ ТОЧКИ ВЗГЛЯДА и редеет с расстоянием кольцами
## (GRASS_RINGS), а дальше фактуру держит зерно в шейдере покрова — оно и
## рассчитано ровно на эту дистанцию (detail_far = 90 м). Круг пересобирается,
## когда камера уезжает от его центра дальше половины GRASS_HOME.
##
## Цвет травы держится БЛИЗКО к цвету покрова под ней. Первый заход был тёмным
## (0.30, 0.42, 0.17) и при редкой посадке читался не травой, а насыпанным
## мусором: тёмные точки по светлому полю. Трава — это фактура земли, а не
## предметы на ней, поэтому она должна лежать в тоне, а не спорить с ним.
## ПОСАДКА ПРИБИТА К МИРУ, А НЕ К ЖРЕБИЮ. Это главное здесь, и добыто оно
## снимком владельца: «трава постоянно прыгает и меняет своё место и вид».
##
## Первый заход сыпал пучки полярным жребием вокруг точки взгляда из общего
## _rng. Значит, при каждой пересадке круга (а она случается на любом движении
## камеры) выпадал ДРУГОЙ набор точек — трава целиком переставлялась. Дефект не в
## пересадке: пересадка обязана быть, круг не может ехать за камерой сплошным
## покровом на два километра. Дефект в том, что положение пучка НЕ БЫЛО ФУНКЦИЕЙ
## МЕСТА.
##
## Теперь пучок сидит в ячейке мировой сетки GRASS_BASE, а всё про него — занята
## ли ячейка, куда внутри неё сдвинут пучок, порода, высота, поворот, оттенок —
## считается хешем от индексов этой ячейки. Пересадка после этого не двигает ни
## одного пучка: те же ячейки дают те же пучки.
##
## Кольца сидят на ТОЙ ЖЕ базовой сетке, беря каждую k-ю ячейку (шаг целый).
## Поэтому дальняя трава стоит в тех же точках, что и ближняя, — при переходе
## кольца пучок может пропасть или появиться, но не переехать. Скольжение глаз
## ловит мгновенно, редкое появление на дальнем плане — нет.
## ЯЧЕЙКА УМЕНЬШЕНА с 0.34 до 0.22 (8.6 -> 20 пучков на м²). Причина не в «мало
## травы вообще», а в том, что видно СВЕРХУ. У вертикального квада площади в плане
## нет, и с высоты каждый пучок — короткий штрих в несколько пикселей. Пока штрихи
## стоят через сорок сантиметров, глаз читает их отдельными предметами на ровном
## поле; чтобы они сложились в фактуру, расстояние между ними должно быть меньше
## их собственной длины. Дальше кольца прореживают всё так же — платит только
## ближний круг, а он и есть тот, на который смотрят.
const GRASS_BASE := 0.22         # м — базовая ячейка посадки: 20 пучков на м² вплотную
## [радиус кольца, шаг по базовой сетке, доля занятых ячеек]. Плотность падает
## примерно вчетверо на кольцо: одна ступень в двадцать раз читалась бы блином.
const GRASS_RINGS := [
	[45.0, 1, 1.00], [90.0, 2, 0.90], [160.0, 3, 0.80], [280.0, 5, 0.70], [420.0, 8, 0.60],
]
const GRASS_HOME := 45.0         # м — ближнее кольцо: по нему решается пересадка
const GRASS_REBUILD := 0.55      # доля GRASS_HOME, после которой круг пересобирается
const GRASS_CLEAR := 2.9         # м — ближе к оси травы нет: там балласт с откосом
const GRASS_CELL := 0.5          # м — сетка маски «здесь балласт, травы нет»
const GRASS_MESH_H := 1.0        # м — высота эталонного пучка

## ЛИСТ — ЭТО ТЕКСТУРА С АЛЬФА-ВЫРЕЗОМ, А НЕ ЗАЛИТЫЙ КВАД. Приём взят из
## SimpleGrassTextured (icterusgames), на который указал владелец, и он же —
## стандарт для стилизованной травы вообще.
##
## Здесь пучок собирался из 3-6 СПЛОШНЫХ квадов: каждый квад — один толстый лист,
## и пучок читался пучком колючек. Отсюда «вся трава одного размера»: у трёх
## жирных лопастей нет внутреннего рисунка, и масштаб — единственное, чем один
## пучок отличается от другого. Текстурный квад несёт ДВА ДЕСЯТКА листьев разной
## длины, ширины и тона внутри себя, поэтому три квада дают полсотни листьев, а
## соседние пучки отличаются не только размером.
##
## Текстура СЧИТАЕТСЯ, а не читается с диска — как щебень, дерево шпалы и зерно
## земли: PNG это лишь способ доставки массива чисел на видеокарту, а массив мы
## умеем построить сами.
##
##   [листьев, ширина листа (доли тайла), изгиб, мин. высота, макс. высота,
##    ширина куста, квадов в меше]
##
## РАЗМЕР ПУЧКА — ПО НАТУРЕ, А НЕ ПО ТОМУ, СКОЛЬКО ЕГО ВИДНО. Пучок был 0.42 м в
## поперечнике и до 0.6 м высотой: это не трава, это куст, и владелец увидел это
## сразу. Раздут он был не по ошибке в числе, а потому что нёс на себе весь
## покров — поверхность под ним травой не была. Теперь дернина в текстуре земли
## (TURF_*), и пучку возвращены его настоящие 10-15 см: он работает силуэтом на
## просвет и на кромке, а покров держит поверхность.
const GRASS_TEX := 160           # px — сторона тайла пучка
const GRASS_KINDS := [
	[24, 0.036, 0.20, 0.10, 0.28, 1.00, 3],   # обычный пучок
	[15, 0.075, 0.44, 0.06, 0.15, 1.55, 3],   # низкая широкая кочка
	[11, 0.020, 0.08, 0.28, 0.62, 0.75, 2],   # метёлка: выше всех, но реже
]
## Палитра пучка: три тона зелени плюс ветошь. Сочная стоит в сомкнутой дернине,
## тёмная — под пологом, светлая и ветошь — на редком покрове и на солнцепёке.
##
## ТЁМНЫЙ КОНЕЦ ПАЛИТРЫ ПОДНЯТ, И ЭТО НЕ ВКУСОВЩИНА. Сверху вертикальный квад
## виден почти с ребра: его площадь в плане — доли сантиметра, а по экрану он
## размазывается в короткий штрих. Штрих, который темнее земли втрое, глаз читает
## не травой, а МУСОРОМ — сухими ветками, насыпанными по лугу. Ровно это и было
## на снимке владельца: чёрная крапка по зелёному полю.
##
## Втрое набиралось перемножением четырёх независимых затемнений: тёмный тон
## палитры (до 0.45 веса), сухость, жребий яркости от 0.82 и тень у корня в
## вершинном цвете меша (0.86), да ещё нижний конец карты листа (shade_lo 0.60).
## Каждое по отдельности разумно, вместе — уголь. Теперь пучок держится В ТОНЕ
## земли под ним: он работает силуэтом и кромкой, а поверхность несёт дернина.
const C_GRASS_LUSH := Color(0.40, 0.55, 0.22)
const C_GRASS_DARK := Color(0.32, 0.45, 0.20)
const C_GRASS_PALE := Color(0.50, 0.58, 0.26)
const C_GRASS_DRY := Color(0.64, 0.56, 0.30)

var _grass_root: Node3D
var _grass_center := Vector3.INF
var _grass_extent := 0.0
var _grass_wait := 0.0
var _grass_meshes: Array[ArrayMesh] = []
var _grass_mats: Array[Material] = []

## Детерминированный жребий по ячейке мира: одно и то же (i, j, соль) всегда даёт
## одно и то же число. Это замена _rng во всём, что касается травы, — именно
## поэтому пересадка круга ничего не двигает. Маски держат положительными: у
## арифметического сдвига вправо отрицательное остаётся отрицательным, и хеш
## вырождается в пилу.
func _hash01(i: int, j: int, salt: int) -> float:
	var h: int = (i * 73856093) ^ (j * 19349663) ^ (salt * 83492791)
	h &= 0x7FFFFFFF
	h = ((h ^ (h >> 15)) * 2246822519) & 0x7FFFFFFF
	h = ((h ^ (h >> 13)) * 3266489917) & 0x7FFFFFFF
	h ^= h >> 16
	return float(h & 0xFFFFFF) / 16777216.0

func _add_grass() -> void:
	if _grass_root == null:
		_grass_root = Node3D.new()
		_grass_root.name = "Grass"
		add_child(_grass_root)
	if _grass_meshes.is_empty():
		for k in GRASS_KINDS.size():
			_grass_meshes.append(_grass_mesh(GRASS_KINDS[k]))
			_grass_mats.append(_mat_grass(GRASS_KINDS[k], k))
	for ch in _grass_root.get_children():
		_grass_root.remove_child(ch)
		ch.queue_free()
	_grass_center = _cam_focus
	_grass_extent = _view_extent()
	# Маска балласта: ячейки ближе GRASS_CLEAR к ЛЮБОЙ осевой. Считается один раз
	# — проверять каждый пучок против всех осевых это миллиарды сравнений.
	var ban := _track_ban(GRASS_CLEAR, GRASS_CELL)
	# Дальний край подстраивается под охват камеры: сажать на 400 м вокруг, когда
	# в кадре тридцать, — это сотни тысяч пучков за краем экрана.
	var far: float = clampf(_grass_extent * 1.3, 150.0, 420.0)
	var cx := _grass_center.x
	var cz := _grass_center.z
	var xf := [[], [], []]
	var cl := [[], [], []]
	var r_in := 0.0
	for ring in GRASS_RINGS:
		var r_out: float = minf(float(ring[0]), far)
		if r_out <= r_in:
			break
		var step := int(ring[1])
		var fill := float(ring[2])
		var cell := GRASS_BASE * step
		var i0 := int(floor((cx - r_out) / cell))
		var i1 := int(floor((cx + r_out) / cell))
		var j0 := int(floor((cz - r_out) / cell))
		var j1 := int(floor((cz + r_out) / cell))
		for ii in range(i0, i1 + 1):
			var bi := ii * step                        # индекс в БАЗОВОЙ сетке
			for jj in range(j0, j1 + 1):
				var bj := jj * step
				# Место пучка — от хеша базовой ячейки, а не от жребия и не от
				# номера кольца: кольца делят одну сетку и дают одни точки.
				var x := bi * GRASS_BASE + _hash01(bi, bj, 1) * GRASS_BASE
				var z := bj * GRASS_BASE + _hash01(bi, bj, 2) * GRASS_BASE
				var d := Vector2(x - cx, z - cz).length()
				if d < r_in or d > r_out:
					continue
				var lot := _hash01(bi, bj, 3)
				if lot > fill:
					continue
				# Внешняя кромка не режется линией: посадка редеет к краю.
				if d > far * 0.78 and _hash01(bi, bj, 4) < smoothstep(0.78, 1.0, d / far):
					continue
				if ban.has(_cell_key(x, z, GRASS_CELL)):
					continue
				var veg := _veg_density(x, z)
				if veg <= 0.001:
					continue
				# КУРТИНЫ: внутри одной дернины трава редеет и густеет пятнами по
				# 10 м. Крупная маска решает, есть ли покров вообще; эта — густоту.
				var tuft: float = 0.5 + 0.5 * _n_tuft.get_noise_2d(x, z)
				if _hash01(bi, bj, 5) > veg * (0.45 + 0.75 * tuft):
					continue
				var y := _height_at(x, z)
				if y < WATER_Y + 0.8:
					continue
				# ПОРОДА ОТ МЕСТА И ЖРЕБИЯ РАЗОМ: метёлки идут только в куртинах,
				# кочки — вперемешку, и оба редко, иначе они перестают быть
				# исключением и силуэт снова становится одним на всех.
				var kk := _hash01(bi, bj, 6)
				var kind := 0
				if tuft > 0.60 and kk < 0.30:
					kind = 2
				elif kk > 0.66:
					kind = 1
				var spec: Array = GRASS_KINDS[kind]
				# ВЫСОТА ИДЁТ ПЯТНАМИ, А НЕ ЖРЕБИЕМ. Жребий по всему полю даёт
				# ровный ворс средней высоты — глаз читает его ковром.
				var lush: float = clampf(veg * (0.30 + 0.90 * tuft), 0.0, 1.0)
				var h: float = lerpf(float(spec[3]), float(spec[4]), lush) \
					* lerpf(0.62, 1.45, _hash01(bi, bj, 7))
				var wide: float = float(spec[5]) * lerpf(0.75, 1.35, _hash01(bi, bj, 8))
				var basis := Basis(Vector3.UP, _hash01(bi, bj, 9) * TAU)
				# Наклон: ни один пучок не стоит по отвесу, и разнобой наклонов —
				# половина того, что отличает луг от щётки.
				var ta := _hash01(bi, bj, 10) * TAU
				# Наклон до 30 градусов: отвесный квад сверху не виден вовсе, у него
				# нет площади в плане, и с высоты пучок пропадает.
				basis = Basis(Vector3(cos(ta), 0.0, sin(ta)), _hash01(bi, bj, 11) * 0.52) * basis
				var t := Transform3D(basis, Vector3(x, y, z))
				var s := h / GRASS_MESH_H
				t.basis = t.basis.scaled(Vector3(s * wide, s, s * wide))
				# ОТТЕНОК: место задаёт середину, жребий разводит соседей. Одного
				# места мало — пучки рядом выходят одной краской.
				var forest := _forest_mask(x, z)
				var dry: float = clampf(0.70 - 0.75 * veg + 0.30 * _n_tone.get_noise_2d(x, z), 0.0, 1.0)
				var col := C_GRASS_LUSH.lerp(C_GRASS_PALE, clampf(0.28 + 0.50 * (lot - 0.5), 0.0, 1.0))
				col = col.lerp(C_GRASS_DARK, _hash01(bi, bj, 12) * 0.34)
				col = col.lerp(C_GRASS_DRY, dry * lerpf(0.20, 0.70, _hash01(bi, bj, 13)))
				col = col.lerp(C_UNDER, forest * 0.45)
				col *= lerpf(0.92, 1.18, _hash01(bi, bj, 14))
				xf[kind].append(t)
				cl[kind].append(_lin(col))
		r_in = r_out
	for k in GRASS_KINDS.size():
		_add_instances(xf[k], cl[k], _grass_meshes[k], 0.95, true, _grass_root, _grass_mats[k])
	print("WORLD: травы %d/%d/%d (круг до %.0f м у %.0f,%.0f)"
		% [xf[0].size(), xf[1].size(), xf[2].size(), far, _grass_center.x, _grass_center.z])

## Пересадка круга травы при уходе камеры. Круг привязан к точке взгляда, и без
## этого панорама уезжает с голой земли — это было бы хуже прежней ленты.
##
## ПЕРЕСАДКА ТОЛЬКО НА ОТЪЕЗД И ОТДАЛЕНИЕ. При приближении круг уже покрывает всё,
## что видно, и пересобирать его незачем — а прежнее условие срабатывало и на
## приближение тоже, то есть трава дёргалась на каждом щипке колёсиком.
## И ждём, пока камера ОСТАНОВИТСЯ: пересборка — это десятки тысяч пучков.
func _process(delta: float) -> void:
	if _grass_center == Vector3.INF:
		return
	var moved := Vector2(_cam_focus.x - _grass_center.x, _cam_focus.z - _grass_center.z).length()
	var out: bool = _view_extent() > _grass_extent * 1.5
	if (moved < GRASS_HOME * GRASS_REBUILD and not out) or Input.get_mouse_button_mask() != 0:
		_grass_wait = 0.0
		return
	_grass_wait += delta
	if _grass_wait > 0.35:
		_grass_wait = 0.0
		_add_grass()

## Что камера видит поперёк кадра, в метрах — по нему считается радиус посадки.
func _view_extent() -> float:
	if _cam_ortho:
		return _cam_size
	return 2.0 * _cam_dist * tan(deg_to_rad(CAM_FOV) * 0.5)

## Пучок: несколько КРЕСТ-НАКРЕСТ поставленных текстурных квадов. НОРМАЛЬ У ВСЕХ
## — ВВЕРХ, а не поперёк листа: тогда пучок освещается как земля, из которой
## растёт, и трава не распадается на чёрные и белые лоскуты при повороте камеры.
## Приём стандартный для стилизованной травы (он же в SimpleGrassTextured) и
## стоит ноль.
##
## Квад слегка ЗАВАЛЕН вершиной в сторону: вертикальный крест читается плоским
## значком, наклонённый — растением.
const GRASS_QUAD_W := 0.16       # м — ширина квада у эталонного пучка

func _grass_mesh(spec: Array) -> ArrayMesh:
	var quads := int(spec[6])
	var lean_k := float(spec[2]) * 0.5
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Тень у корня рисует САМА карта листа (там значение падает к 0.42), и второй
	# раз её класть вершинным цветом нельзя: два затемнения на одну величину и
	# давали чёрный штрих сверху. Здесь остаётся только просветление кончика.
	var base := Color(1.0, 1.0, 1.0)
	var tip := Color(1.05, 1.05, 1.05)
	for k in quads:
		var a := PI * k / float(quads)
		var d := Vector3(cos(a), 0.0, sin(a)) * (GRASS_QUAD_W * 0.5)
		var lean := Vector3(cos(a + 1.9), 0.0, sin(a + 1.9)) * (GRASS_MESH_H * lean_k)
		var top := Vector3(0.0, GRASS_MESH_H, 0.0) + lean
		# UV: v=1 у корня, v=0 у верхушки — так же лежит и тайл (кончики вверху),
		# и на этом же v держится размах ветра в шейдере.
		_quad_uv(tool, -d, d, top + d, top - d,
			Vector2(0.0, 1.0), Vector2(1.0, 1.0), Vector2(1.0, 0.0), Vector2(0.0, 0.0),
			base, base, tip, tip)
	return tool.commit()

## Квад с UV и нормалью вверх. Родительский _quad_cn UV не кладёт: земле и кронам
## они не нужны (там трипланар и вершинный цвет), а траве нужны — на них лежит
## лист.
func _quad_uv(tool: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3,
		t0: Vector2, t1: Vector2, t2: Vector2, t3: Vector2,
		c0: Color, c1: Color, c2: Color, c3: Color) -> void:
	var l0 := _lin(c0)
	var l1 := _lin(c1)
	var l2 := _lin(c2)
	var l3 := _lin(c3)
	tool.set_normal(Vector3.UP)
	tool.set_uv(t0); tool.set_color(l0); tool.add_vertex(p0)
	tool.set_uv(t1); tool.set_color(l1); tool.add_vertex(p1)
	tool.set_uv(t2); tool.set_color(l2); tool.add_vertex(p2)
	tool.set_uv(t0); tool.set_color(l0); tool.add_vertex(p0)
	tool.set_uv(t2); tool.set_color(l2); tool.add_vertex(p2)
	tool.set_uv(t3); tool.set_color(l3); tool.add_vertex(p3)

## --- тайл пучка: листья рисуются, а не берутся с диска ------------------------
## Лист — мазок от корня к кончику: центр уходит вбок по квадратичной кривой
## (у травы изгиб растёт к верхушке, а не идёт прямой наклонной), ширина сходит
## на нет, тон светлеет. Разброс длины, ширины, стороны изгиба и тона — по хешу
## номера листа, тем же, что расставляет пучки.
##
## АЛЬФА БИНАРНАЯ, и вырез делает материал (alpha scissor + alpha-to-coverage при
## MSAA). Полупрозрачность здесь брать нельзя: пучков десятки тысяч, они входят
## друг в друга, и любая сортировка по глубине на них разваливается.
func _grass_image(spec: Array, salt: int) -> Image:
	var n := int(spec[0])
	var bw := float(spec[1])
	var bend := float(spec[2])
	var img := Image.create_empty(GRASS_TEX, GRASS_TEX, false, Image.FORMAT_RGBA8)
	# ФОН ЗАЛИТ СРЕДНИМ ТОНОМ ЛИСТА, А НЕ ЧЁРНЫМ, хотя он и прозрачен. Мип
	# усредняет ВСЕ каналы, включая цвет невидимых пикселей: при чёрном фоне трава
	# на средней дистанции темнела вдвое и читалась бурой щёткой на светлом лугу —
	# ровно это и было на снимке. Прозрачность гасит пиксель, но не исключает его
	# из усреднения; цвет под альфой обязан продолжать соседний видимый.
	img.fill(Color(0.62, 0.62, 0.62, 0.0))
	for b in n:
		var x0 := (0.08 + 0.84 * _hash01(b, salt, 21)) * GRASS_TEX
		var hb := (0.52 + 0.48 * _hash01(b, salt, 22)) * GRASS_TEX
		var side := 1.0 if _hash01(b, salt, 23) > 0.5 else -1.0
		var curve := side * bend * GRASS_TEX * (0.4 + 1.2 * _hash01(b, salt, 24))
		var w0 := bw * GRASS_TEX * (0.7 + 0.7 * _hash01(b, salt, 25))
		var tint := 0.68 + 0.32 * _hash01(b, salt, 26)
		var steps := int(hb) * 2
		for s in steps + 1:
			var t := float(s) / float(steps)      # 0 у корня, 1 у кончика
			var py := int(GRASS_TEX - 1 - t * hb)
			if py < 0 or py >= GRASS_TEX:
				continue
			var cxp := x0 + curve * t * t
			var hw := w0 * (1.0 - t * t) * 0.5 + 0.35
			# Значение — НЕ ЦВЕТ, а множитель яркости листа: 0 у корня в тени,
			# 1 на освещённом кончике. Цвет пучка приходит цветом экземпляра.
			var v: float = clampf(tint * lerpf(0.42, 1.0, t), 0.0, 1.0)
			var col := Color(v, v, v, 1.0)
			for px in range(int(floor(cxp - hw)), int(ceil(cxp + hw)) + 1):
				if px >= 0 and px < GRASS_TEX:
					img.set_pixel(px, py, col)
	img.generate_mipmaps()
	return img

## ВЕТЕР КАЧАЕТ ВЕРХУШКУ, А НЕ ПУЧОК ЦЕЛИКОМ: размах растёт как квадрат высоты по
## UV, у корня он ноль — иначе трава ездит по земле, как приклеенная картинка.
##
## ЧЕСТНОЕ ОГРАНИЧЕНИЕ: сдвиг считается в МЕСТНЫХ осях пучка, а поворот вокруг
## вертикали у каждого пучка свой — значит единого направления ветра нет, каждый
## качается по-своему. Фаза при этом взята от МИРОВОГО положения, поэтому порыв
## всё равно бежит по лугу волной, и на глаз это читается ветром. Правильное
## лечение — переводить мировое направление в местные оси, но это inverse матрицы
## на вершину при десятках тысяч пучков.
const GRASS_SHADER := """
shader_type spatial;
render_mode cull_disabled, depth_prepass_alpha, diffuse_burley;

// БЕЗ source_color, И ЭТО НЕ МЕЛОЧЬ. Первый заход объявил тайл цветом — движок
// перевёл его из sRGB в линейное, а цвет экземпляра УЖЕ линейный (_lin), и трава
// вышла чёрной щёткой: два перевода подряд на одну величину. Тайл здесь не цвет,
// а карта яркости листа, поэтому берётся сырым и раскладывается в множитель
// вокруг единицы — тем же приёмом, что зерно земли в шейдере покрова.
uniform sampler2D blade : filter_linear_mipmap, repeat_disable;
uniform float shade_lo;          // во что превращается 0 карты листа
uniform float shade_hi;          // и во что — 1
uniform float wind_speed;
uniform float wind_amp;          // доли высоты пучка — размах верхушки
uniform float wind_len;          // м — длина волны порыва по лугу
uniform float cutoff;            // порог альфа-выреза

void vertex() {
	float up = 1.0 - UV.y;               // 0 у корня, 1 у верхушки
	vec3 w = MODEL_MATRIX[3].xyz;
	float ph = TIME * wind_speed + (w.x + w.z * 0.6) / wind_len;
	float s = (sin(ph) + 0.45 * sin(ph * 2.7 + 1.3)) * wind_amp * up * up;
	VERTEX.x += s;
	VERTEX.y -= abs(s) * 0.25;           // верхушка при наклоне ОПУСКАЕТСЯ
}

void fragment() {
	// НОРМАЛЬ ВОЗВРАЩАЕТСЯ ВВЕРХ. Меш кладёт её вверх нарочно (см. _grass_mesh),
	// но render_mode cull_disabled включает в шаблоне Godot проверку стороны:
	// на изнанке грани движок сам ставит NORMAL = -NORMAL. То есть у КАЖДОГО
	// квада одна сторона получала нормаль ВНИЗ и освещалась солнцем в спину.
	//
	// Это и была «убогая трава», и найдено оно замером, а не глазом: подмена
	// альбедо на плоскую заливку дала половину пучков яркими, половину почти
	// чёрными при ОДНОМ И ТОМ ЖЕ цвете. Никакая правка палитры этого не лечит —
	// чинить надо нормаль. FRONT_FACING отменяет переворот обратно.
	if (!FRONT_FACING) {
		NORMAL = -NORMAL;
	}
	vec4 t = texture(blade, UV);
	ALBEDO = COLOR.rgb * (shade_lo + (shade_hi - shade_lo) * t.r);
	ALPHA = t.a;
	ALPHA_SCISSOR_THRESHOLD = cutoff;
	ROUGHNESS = 0.94;
	SPECULAR = 0.1;
}
"""

func _mat_grass(spec: Array, kind: int) -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = GRASS_SHADER
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("blade", ImageTexture.create_from_image(_grass_image(spec, kind)))
	# Середина карты листа ложится примерно на единицу: тайл ТЕКСТУРИРУЕТ пучок,
	# а не притемняет его целиком (та же выкладка, что у зерна земли).
	m.set_shader_parameter("shade_lo", 0.82)
	m.set_shader_parameter("shade_hi", 1.14)
	m.set_shader_parameter("wind_speed", 1.15)
	# Метёлка выше и тоньше — её мотает заметно сильнее дернины.
	m.set_shader_parameter("wind_amp", 0.16 if kind == 2 else 0.07)
	m.set_shader_parameter("wind_len", 26.0)
	# Порог низкий: мипы усредняют альфу, и при 0.5 дальняя трава пропадала бы
	# ровно там, где её и так мало.
	m.set_shader_parameter("cutoff", 0.22)
	return m

## --- общие маски посадки ------------------------------------------------------
## Ячейка сетки как ОДНО ЦЕЛОЕ ЧИСЛО. Множитель простой и заведомо больше размаха
## индексов по одной оси, поэтому пары (i, j) не сталкиваются.
const CELL_HASH := 100003

func _cell_key(x: float, z: float, cell: float) -> int:
	return int(floor(x / cell)) * CELL_HASH + int(floor(z / cell))

## Ячейки ближе radius к ЛЮБОЙ осевой — там путь, и растительности нет. Строится
## один раз на проход посадки: проверять каждый пучок против всех осевых — это
## сотни тысяч пучков на четыреста осевых, то есть сотни миллионов сравнений.
func _track_ban(radius: float, cell: float) -> Dictionary:
	var ban := {}
	var r := int(ceil(radius / cell))
	for p in _cl_pts:
		var ci := int(floor(p.x / cell))
		var cj := int(floor(p.z / cell))
		for di in range(-r, r + 1):
			for dj in range(-r, r + 1):
				if di * di + dj * dj <= r * r:
					ban[(ci + di) * CELL_HASH + (cj + dj)] = true
	return ban

## mat != null — материал берётся готовым (трава: свой шейдер с ветром и вырезом);
## иначе строится обычный вершинно-цветной StandardMaterial3D.
func _add_instances(xforms: Array, colors: Array, mesh: ArrayMesh, rough: float,
		two_sided: bool = false, parent: Node = null, mat_over: Material = null) -> void:
	if xforms.is_empty():
		return
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = mesh
	mm.instance_count = xforms.size()
	for k in xforms.size():
		mm.set_instance_transform(k, xforms[k])
		mm.set_instance_color(k, colors[k])
	var mi := MultiMeshInstance3D.new()
	mi.multimesh = mm
	if mat_over != null:
		mi.material_override = mat_over
		# ТРАВА ТЕНИ НЕ БРОСАЕТ. Десятки тысяч альфа-вырезанных пучков в карте
		# теней — это и дорого, и вредно: собственная тень каждого листа съедает
		# луг в тёмную кашу, а даёт крапку размером в пиксель. Тени держат
		# деревья, кусты и путь; трава живёт заливкой и наклоном.
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	else:
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(1, 1, 1)
		mat.vertex_color_use_as_albedo = true
		mat.roughness = rough
		if two_sided:
			# Лист без толщины обязан быть виден с изнанки, иначе половина
			# растения пропадает при повороте камеры.
			mat.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi.material_override = mat
	if parent == null:
		parent = self
	parent.add_child(mi)

## Ель эталонной высоты TREE_MESH_H: два яруса конусов на коротком стволе.
## spread — раскидистость: 0.78 даёт свечку, 1.24 — раскидистую ель. Силуэт
## меняется заметно, а меш тот же.
func _tree_mesh_spruce(spread: float) -> ArrayMesh:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	_cone(tool, 0.9, 2.6 * spread, 5.2, Color(1, 1, 1))          # нижний ярус
	_cone(tool, 4.6, 1.8 * spread, 7.6, Color(0.96, 0.98, 0.96)) # верхний, чуть светлее
	_cylinder(tool, 0.0, 0.22, 1.1, Color(0.42, 0.34, 0.26))
	return tool.commit()

## Лиственное: округлая крона на голом стволе. Ствол ВИДЕН — этим оно и
## отличается от ели на расстоянии, где сама крона уже пятно.
func _tree_mesh_broadleaf() -> ArrayMesh:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	_cylinder(tool, 0.0, 0.32, 4.2, Color(0.45, 0.37, 0.28))
	_crown(tool, 3.4, 3.4, 8.2, Color(1, 1, 1))
	return tool.commit()

func _bush_mesh() -> ArrayMesh:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	_crown(tool, 0.0, 1.5, BUSH_MESH_H, Color(1, 1, 1))
	return tool.commit()

## Низкий раскидистый: шире, чем выше. Второй силуэт нужен по той же причине, по
## какой у леса три породы — одинаковые кусты читаются не зарослью, а горошком.
##
## РАСКИДИСТЫЙ — ЭТО НЕ БЛИН. Радиус 2.1 при высоте 1.3 давал шайбу вчетверо шире
## своей высоты, и на снимке она читалась не кустом, а вкопанной летающей
## тарелкой. Куст шире высоты примерно вдвое, не больше.
func _bush_mesh_low() -> ArrayMesh:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	_crown(tool, 0.0, 1.15, BUSH_LOW_MESH_H, Color(1, 1, 1))
	# Второй ком сбоку: одиночный эллипсоид читается шаром, а куст — это несколько
	# сросшихся шапок.
	_crown(tool, 0.0, 0.8, BUSH_LOW_MESH_H * 0.72, Color(0.94, 0.96, 0.94),
		Vector3(0.85, 0.0, 0.35))
	return tool.commit()

## Округлая крона: низкополигональный эллипсоид из поясов. Полюса вырождаются в
## треугольники — это нормально, вырожденные квады растеризатор отбрасывает сам.
func _crown(tool: SurfaceTool, y0: float, r: float, h: float, tint: Color,
		off: Vector3 = Vector3.ZERO) -> void:
	var seg := 8
	var rings := 3
	var cy := y0 + h * 0.5
	var ry := h * 0.5
	var lat := []
	for k in rings + 1:
		var ang := PI * (float(k) / rings - 0.5)      # -90..+90 по широте
		lat.append(Vector2(cos(ang) * r, sin(ang) * ry))
	for k in rings:
		var a: Vector2 = lat[k]
		var b: Vector2 = lat[k + 1]
		for s in seg:
			var a0 := TAU * s / seg
			var a1 := TAU * (s + 1) / seg
			var p0 := Vector3(cos(a0) * a.x, cy + a.y, sin(a0) * a.x) + off
			var p1 := Vector3(cos(a1) * a.x, cy + a.y, sin(a1) * a.x) + off
			var p2 := Vector3(cos(a1) * b.x, cy + b.y, sin(a1) * b.x) + off
			var p3 := Vector3(cos(a0) * b.x, cy + b.y, sin(a0) * b.x) + off
			var c := Vector3(0.0, cy, 0.0) + off
			_quad_cn(tool, p0, p1, p2, p3,
				(p0 - c).normalized(), (p1 - c).normalized(),
				(p2 - c).normalized(), (p3 - c).normalized(),
				tint, tint, tint, tint)

## Конус с ГЛАДКОЙ нормалью по окружности: силуэт остаётся многоугольным (и
## пусть, стилизация на нём и держится), а заливка перестаёт распадаться на
## тёмные и светлые клинья. Восемь сегментов вместо шести — силуэт ёлки на
## общем плане это ~4 пикселя, а вблизи разница видна.
func _cone(tool: SurfaceTool, y0: float, r: float, h: float, tint: Color) -> void:
	var seg := 8
	var apex := Vector3(0.0, y0 + h, 0.0)
	for s in seg:
		var a0 := TAU * s / seg
		var a1 := TAU * (s + 1) / seg
		var am := (a0 + a1) * 0.5
		var p0 := Vector3(cos(a0) * r, y0, sin(a0) * r)
		var p1 := Vector3(cos(a1) * r, y0, sin(a1) * r)
		_tri_cn(tool, p0, p1, apex,
			_cone_n(a0, r, h), _cone_n(a1, r, h), _cone_n(am, r, h), tint)
		_tri_cn(tool, p1, p0, Vector3(0.0, y0, 0.0),
			Vector3.DOWN, Vector3.DOWN, Vector3.DOWN, tint * 0.85)  # донце яруса

## Нормаль боковой поверхности конуса на угле a: наклон задаётся отношением
## радиуса к высоте, поэтому у низкого широкого яруса она заметно завалена.
func _cone_n(a: float, r: float, h: float) -> Vector3:
	return Vector3(cos(a) * h, r, sin(a) * h).normalized()

func _cylinder(tool: SurfaceTool, y0: float, r: float, h: float, tint: Color) -> void:
	var seg := 5
	for s in seg:
		var a0 := TAU * s / seg
		var a1 := TAU * (s + 1) / seg
		var b0 := Vector3(cos(a0) * r, y0, sin(a0) * r)
		var b1 := Vector3(cos(a1) * r, y0, sin(a1) * r)
		_quad_c(tool, b0, b1, b1 + Vector3.UP * h, b0 + Vector3.UP * h,
			tint, tint, tint, tint)

## --- посёлок ----------------------------------------------------------------
## Коробка с крышей-плитой. Только ради масштаба: без построек станция читается
## макетом, а не местом. Формат зданий не несёт, и это здесь не предлагается.
func _add_village() -> void:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var spots := VILLAGE
	for k in spots.size():
		var s: Vector2 = spots[k]
		var w := _rng.randf_range(16.0, 30.0)
		var d := _rng.randf_range(14.0, 24.0)
		var hgt := _rng.randf_range(7.0, 16.0)
		var y := _height_at(s.x, s.y)
		var c: Color = HOUSE_COLORS[k % HOUSE_COLORS.size()]
		var yaw := _rng.randf_range(-0.25, 0.25)
		var a := Vector3(cos(yaw), 0.0, sin(yaw))
		var b := Vector3(-a.z, 0.0, a.x)
		# Сверху видно КРЫШУ, значит цвет несёт она, а стены только оттеняют:
		# при обратном раскладе посёлок с высоты станции читался серыми плитами.
		# Заглубление на 2 м, а не на 0.5: коробка с плоским низом на склоне
		# встаёт на ножки, и посёлок выглядит стоящим на сваях.
		_box_c(tool, Vector3(s.x, y + hgt * 0.5 - 2.0, s.y), a, b, w * 0.5, d * 0.5, hgt * 0.5,
			c.darkened(0.22))
		# Крыша САДИТСЯ НА СТЕНУ с перекрытием: щель в 10 см между ними
		# читается домом, висящим на ножках.
		_box_c(tool, Vector3(s.x, y + hgt - 1.7, s.y), a, b, w * 0.5 + 0.7, d * 0.5 + 0.7, 0.6,
			c.lerp(C_ROOF, 0.18))
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(1, 1, 1)
	mat.vertex_color_use_as_albedo = true
	mat.roughness = 0.9
	_commit(tool, mat)

## --- свет -------------------------------------------------------------------
## Солнце выше и теплее, амбиент от неба, дымка вдаль. Ключевое отличие от
## спайка №1 — не яркость, а два источника контраста: тень от солнца под углом и
## воздушная перспектива, которая отодвигает дальние холмы.
func _add_environment() -> void:
	var env := Environment.new()
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.30, 0.50, 0.78)
	sky_mat.sky_horizon_color = Color(0.78, 0.86, 0.93)
	# Нижняя половина неба — это то, что видно ЗА дальним краем юбки. Тёмный
	# цвет там читается чёрной полосой над горизонтом, то есть тем же обрывом:
	# оба тона держим в дымке.
	sky_mat.ground_horizon_color = Color(0.74, 0.81, 0.87)
	sky_mat.ground_bottom_color = Color(0.52, 0.60, 0.57)
	sky_mat.sun_angle_max = 12.0
	var sky := Sky.new()
	sky.sky_material = sky_mat
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.38
	env.fog_enabled = true
	env.fog_light_color = Color(0.72, 0.80, 0.88)
	env.fog_density = 0.00018
	env.fog_aerial_perspective = 0.30
	env.fog_sky_affect = 0.0
	env.ssao_enabled = true       # только Forward+; в GL Compatibility молча игнорируется
	# РАДИУС SSAO — В МЕТРАХ МИРА, а не в пикселях. Шесть метров подобраны под
	# общий план; вблизи это значит, что каждая шпала затемняет площадку вокруг
	# себя, и балласт покрывается синеватыми кляксами. Полтора метра работают на
	# обоих планах.
	env.ssao_radius = 1.5
	env.ssao_intensity = 1.1
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)
	var light := DirectionalLight3D.new()
	light.rotation_degrees = Vector3(-48.0, -128.0, 0.0)
	light.light_energy = 1.05
	light.light_color = Color(1.0, 0.97, 0.90)
	light.shadow_enabled = true
	# Тень от солнца имеет полутень: диск светила ~0.5 градуса, плюс дымка.
	# Резкая тень от точечного источника — вторая половина «угловатости».
	light.light_angular_distance = 1.6
	light.shadow_blur = 1.4
	light.directional_shadow_max_distance = 900.0
	light.directional_shadow_blend_splits = true
	add_child(light)
	var fill := DirectionalLight3D.new()
	fill.rotation_degrees = Vector3(-30.0, 60.0, 0.0)
	fill.light_energy = 0.22
	fill.light_color = Color(0.80, 0.88, 1.0)
	add_child(fill)

## --- примитивы с цветом в вершинах -------------------------------------------
## Родительский _quad цвета не кладёт и переворачивает нормаль (обход бага
## llvmpipe). Здесь и цвет, и знак нормали через NORMAL_SIGN.
## ЦВЕТ ВЕРШИНЫ ИДЁТ В ШЕЙДЕР ЛИНЕЙНЫМ. albedo_color StandardMaterial3D движок
## переводит из sRGB сам, а set_color/set_instance_color — нет: число уходит в
## шейдер как есть, и 0.41 sRGB, принятое за линейное, выходит на экран как 0.67.
## Отсюда была выбеленная земля при правильных на бумаге числах. Все константы
## палитры записаны в sRGB (как их видит глаз и пипетка), перевод — здесь.
func _lin(c: Color) -> Color:
	return c.srgb_to_linear()

func _quad_c(tool: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3,
		c0: Color, c1: Color, c2: Color, c3: Color) -> void:
	var n := (p1 - p0).cross(p2 - p0).normalized() * NORMAL_SIGN
	var l0 := _lin(c0)
	var l1 := _lin(c1)
	var l2 := _lin(c2)
	var l3 := _lin(c3)
	tool.set_normal(n)
	tool.set_color(l0); tool.add_vertex(p0)
	tool.set_color(l1); tool.add_vertex(p1)
	tool.set_color(l2); tool.add_vertex(p2)
	tool.set_color(l0); tool.add_vertex(p0)
	tool.set_color(l2); tool.add_vertex(p2)
	tool.set_color(l3); tool.add_vertex(p3)

## То же, что _quad_c, но нормаль задаётся в каждой вершине своя (гладкая
## заливка). Нормали передаются НАРУЖНЫМИ — знак уже учтён вызывающим.
func _quad_cn(tool: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3,
		n0: Vector3, n1: Vector3, n2: Vector3, n3: Vector3,
		c0: Color, c1: Color, c2: Color, c3: Color) -> void:
	var l0 := _lin(c0)
	var l1 := _lin(c1)
	var l2 := _lin(c2)
	var l3 := _lin(c3)
	tool.set_normal(n0); tool.set_color(l0); tool.add_vertex(p0)
	tool.set_normal(n1); tool.set_color(l1); tool.add_vertex(p1)
	tool.set_normal(n2); tool.set_color(l2); tool.add_vertex(p2)
	tool.set_normal(n0); tool.set_color(l0); tool.add_vertex(p0)
	tool.set_normal(n2); tool.set_color(l2); tool.add_vertex(p2)
	tool.set_normal(n3); tool.set_color(l3); tool.add_vertex(p3)

func _tri_c(tool: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3, c: Color) -> void:
	var n := (p1 - p0).cross(p2 - p0).normalized() * NORMAL_SIGN
	var l := _lin(c)
	tool.set_normal(n)
	tool.set_color(l); tool.add_vertex(p0)
	tool.set_color(l); tool.add_vertex(p1)
	tool.set_color(l); tool.add_vertex(p2)

func _tri_cn(tool: SurfaceTool, p0: Vector3, p1: Vector3, p2: Vector3,
		n0: Vector3, n1: Vector3, n2: Vector3, c: Color) -> void:
	var l := _lin(c)
	tool.set_normal(n0); tool.set_color(l); tool.add_vertex(p0)
	tool.set_normal(n1); tool.set_color(l); tool.add_vertex(p1)
	tool.set_normal(n2); tool.set_color(l); tool.add_vertex(p2)

func _box_c(tool: SurfaceTool, c: Vector3, a: Vector3, b: Vector3,
		ha: float, hb: float, hu: float, col: Color) -> void:
	var up := Vector3.UP
	var t := [
		c + a * ha + b * hb + up * hu, c - a * ha + b * hb + up * hu,
		c - a * ha - b * hb + up * hu, c + a * ha - b * hb + up * hu,
	]
	var bo := [
		c + a * ha + b * hb - up * hu, c - a * ha + b * hb - up * hu,
		c - a * ha - b * hb - up * hu, c + a * ha - b * hb - up * hu,
	]
	var side := col * 0.86
	# СТЕНЫ ОБХОДЯТСЯ В ОБРАТНУЮ СТОРОНУ ОТ КРЫШИ. У крыши (t0..t3) разность
	# (p1-p0)×(p2-p0) выходит -Y, то есть ОТ зрителя сверху, и грань лицевая; у
	# стен та же запись даёт разность НАРУЖУ, а это для Godot изнанка — стены
	# срезались отсечением, и посёлок с высоты читался цветными плитами без
	# объёма. Тот же дефект, что был у пути (см. _quad в spike_relief.gd).
	_quad_c(tool, t[0], t[1], t[2], t[3], col, col, col, col)
	_quad_c(tool, t[3], t[2], bo[2], bo[3], side, side, side, side)
	_quad_c(tool, t[2], t[1], bo[1], bo[2], side, side, side, side)
	_quad_c(tool, t[1], t[0], bo[0], bo[1], side, side, side, side)
	_quad_c(tool, t[0], t[3], bo[3], bo[0], side, side, side, side)
