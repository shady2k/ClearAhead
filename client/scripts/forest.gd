## Forest — деревья из битовой карты сервера в РАЗМЕЩЁННЫЕ стволы. Ни одного меша.
##
## # Что здесь свойство мира, а что решение художника
##
## Решение владельца 2026-08-12: «сервер не должен отдавать ель; ель рисует
## клиент, сервер говорит ГДЕ она и КАКАЯ». Отсюда граница, которая и снимает
## спор «рецепт против выпечки» из спеки каталога ассетов:
##
##     Ассетом едет то, форма чего НЕ ВЫВОДИТСЯ ИЗ ФАКТОВ.
##
## Ель выводится: положение, порода и высота — факты, и по ним клиент строит
## меш сам. Локомотив не выводится — его форму не задать перечнем размеров, и
## он остаётся ассетом. Заодно это снимает возражение спеки: запечённый .glb
## ели нёс бы ТЕССЕЛЯЦИЮ, а тесселяция по контракту отрисовки §1 принадлежит
## клиенту, то есть сервер отдавал бы вместе с мешем уже принятое клиентское
## решение.
##
## # Почему высота считается хешем, а не приезжает байтом
##
## Высота дерева — факт: его можно спилить и померить. Значит два рендерера
## обязаны получить ОДНО число. Байт на дерево стоил бы вчетверо дороже всего
## блоба (512 Б против 2 КБ), поэтому вместо байта — функция адреса, одинаковая
## у сервера и клиента, и она ЧАСТЬ КОНТРАКТА (chunk.ForestJitter).
##
## Функция ЦЕЛОЧИСЛЕННАЯ намеренно. Проект уже терял эталон контракта на сверке
## вычисленных float64 (расхождение ~1e-13 при неизменном коде), и правило
## записано: float64 не сверяется байт в байт. Целочисленный хеш этому правилу
## не подчиняется — он совпадает на любой машине точно, и потому его эталонные
## значения проверяются в tools/check.gd прямым равенством.
class_name Forest
extends RefCounted

## Маски логического сдвига вправо для 64 бит. GDScript хранит int знаковым, и
## `>>` у него арифметический: у отрицательного числа он тянет единицы. Хеш же
## определён над беззнаковым, поэтому старшие биты гасятся явно.
const _M34 := (1 << 34) - 1
const _M37 := (1 << 37) - 1
const _M33 := (1 << 33) - 1
const _U32 := 0xFFFFFFFF

## Константы splitmix64 записаны ОТРИЦАТЕЛЬНЫМИ: 0x9E3779B97F4A7C15 и соседние
## не помещаются в знаковый int64, и запись их в шестнадцатеричном виде GDScript
## не примет. Значения — те же биты в дополнительном коде.
const _GOLDEN := -0x61C8864680B583EB  # 0x9E3779B97F4A7C15
const _MIX1 := -0x40A7B892E31B1A47    # 0xBF58476D1CE4E5B9
const _MIX2 := -0x6B2FB644ECCEEE15    # 0x94D049BB133111EB


static func _mix(z: int) -> int:
	z ^= (z >> 30) & _M34
	z *= _MIX1
	z ^= (z >> 27) & _M37
	z *= _MIX2
	z ^= (z >> 31) & _M33
	return z


## jitter — три числа в [0, 1): смещение по x и z внутри ячейки и доля высоты.
##
## Совпадение с сервером проверяется эталонными значениями в check.gd. Эталон
## возможен именно потому, что хеш целочисленный: у float64 он не пережил бы
## смены машины, и проект это уже проверил на себе.
##
## # Почему НЕ Vector3, хотя три числа просятся в него
##
## Куплено ошибкой в тот же час. Первая редакция возвращала Vector3, эталон
## разошёлся на всех пяти адресах, и виноват был не хеш: у Vector3 компоненты
## float32, и точность, добытую целочисленной арифметикой, теряла УПАКОВКА — на
## шаг позже алгоритма и на шаг раньше сравнения.
##
## Урок проекта «float64 не сверяется байт в байт» здесь работает наоборот: у
## нас есть величина, которую сверять почти точно МОЖНО, и терять эту редкость
## ради удобного типа нельзя.
static func jitter(cx: int, cz: int, i: int, j: int) -> PackedFloat64Array:
	var k := ((cx & _U32) << 32) | (cz & _U32)
	var c := (((j * 64 + i) & _U32) + _GOLDEN)
	var m := _mix(k ^ _mix(c))
	var dx := float(m & _U32) / 4294967296.0
	m = _mix(m)
	var dz := float(m & _U32) / 4294967296.0
	m = _mix(m)
	var h := float(m & _U32) / 4294967296.0
	return PackedFloat64Array([dx, dz, h])


## Одно дерево: место, порода и высота ствола.
##
## Зовётся Stem, а не Tree, потому что Tree занято НАТИВНЫМ классом Godot
## (элемент интерфейса — дерево списка), и объявление своего роняет разбор всего
## файла с «Class "Tree" hides a native class». Stem — лесоводческий термин для
## отдельного дерева, а не выдумка ради обхода: путать его не с чем.
class Stem:
	var x: float
	var y: float
	var z: float
	## Класс покрова той же ячейки: порода наследуется от него и стоит ноль байт.
	var species: int
	var height_m: float


## ВЫСОТА СТВОЛА — РЕШЕНИЕ ХУДОЖНИКА, и это надо назвать, потому что соседнее
## число им не является. Сервер даёт долю [0, 1) функцией адреса; во что её
## развернуть — в 11…19 м или в 6…30 — контракт не говорит.
##
## Пока диапазон не назван контрактом, он живёт здесь вместе с цветом класса и
## уедет туда же — в каталог ассетов, где у породы появятся её размеры. Числа
## взяты у снесённого спайка (разбор §1.3), чтобы не подбирать второй раз.
const TREE_H_MIN := 11.0
const TREE_H_MAX := 19.0
## Лиственные у спайка были ниже хвойных на 15 %.
const BROAD_SCALE := 0.85


## trees — деревья чанка из битовой карты и покрова.
##
## Ячейка занята битом — дерево есть. Класс берётся из ПОКРОВА той же ячейки, и
## если он не лесной, дерево НЕ РИСУЕТСЯ: сервер держит инвариант «бит только в
## лесном классе» по построению, и его нарушение означает расхождение слоёв, а
## не повод подставить правдоподобную породу.
##
## Отметка берётся из уже присланных высот билинейно по четырём отсчётам ячейки:
## дерево стоит на земле, и её отметка — не новые данные, а уже приехавшие.
static func trees(forest: PackedByteArray, cover: PackedByteArray, heights: PackedFloat32Array,
		base_z_m: float, samples: int, cx: int, cz: int, side_m: float) -> Dictionary:
	var cells := samples - 1
	var out: Array[Stem] = []
	var mismatched := 0
	if forest.size() != cells * cells / 8 or cover.size() != cells * cells:
		return {"list": out, "mismatched": 0}
	var step := side_m / float(cells)
	var ox := float(cx) * side_m
	var oz := float(cz) * side_m
	for j in cells:
		for i in cells:
			var k := j * cells + i
			# Скобки обязательны: в GDScript сравнение связывает КРЕПЧЕ битового
			# И, поэтому `a & b == 0` разобралось бы как `a & (b == 0)`.
			if (forest[k / 8] & (1 << (k % 8))) == 0:
				continue
			var packed := cover[k]
			var species := packed >> 4
			if species != TerrainMesh.SURFACE_FOREST_CONIFER and species != TerrainMesh.SURFACE_FOREST_BROAD:
				mismatched += 1
				continue
			var jt := jitter(cx, cz, i, j)
			var t := Stem.new()
			t.x = ox + (float(i) + jt[0]) * step
			t.y = oz + (float(j) + jt[1]) * step
			# Отметка — из отсчёта, ближайшего к стволу. Билинейная выборка была
			# бы точнее на полсантиметра и стоила бы четырёх обращений на дерево;
			# ствол диаметром в полметра этой разницы не замечает.
			# Пустой массив высот — законный вызов: проверки инварианта «бит
			# только в лесном классе» отметка не нужна вовсе, а требовать её
			# значило бы тащить в проверку декодирование чанка ради числа,
			# которое она не смотрит.
			if heights.is_empty():
				t.z = base_z_m
			else:
				var si := mini(i + int(round(jt[0])), samples - 1)
				var sj := mini(j + int(round(jt[1])), samples - 1)
				t.z = base_z_m + float(heights[sj * samples + si]) * 0.01
			t.species = species
			t.height_m = TREE_H_MIN + jt[2] * (TREE_H_MAX - TREE_H_MIN)
			if species == TerrainMesh.SURFACE_FOREST_BROAD:
				t.height_m *= BROAD_SCALE
			out.append(t)
	return {"list": out, "mismatched": mismatched}
