; ClearAhead — клиент, веха В1.
;
; ЗАКОН ЭТОГО КЛИЕНТА: чего сервер не прислал, того на экране нет.
; Ни одной зашитой константы, описывающей мир. Числа правила подробности,
; размеры сетки, высоты, примитивы пути — всё приезжает с сервера.
; Клиент считает из них геометрию (меш, тесселяция, нормали) — это его работа,
; граница записана в биде ClearAhead-sjq.

config_version=5

[application]

config/name="ClearAhead"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

; FORWARD+, а не mobile. Абзац перенесён от снесённого спайка (его project.godot
; жив в истории: git show 809280f^:client/project.godot) и обновлён под сегодня.
;
; Довод спайка был и остаётся простым: игра одна — настройка одна, а мир
; рассчитывает на тени, дымку и SSAO, которых в gl_compatibility нет. У mobile
; своя недостача, и она ровно та же по последствию: SSAO там не существует,
; движок отвечает предупреждением и молча его игнорирует.
;
; Мобильным клиент стал 2026-08-12 (коммит cf47ccb) МОЛЧА — ни строки о том,
; зачем. Это не решение, а потеря: снимок владельца показал плоскую зелёную
; заливку вместо земли спайка, и половина разницы держалась здесь.
;
; На машине без ускорителя метод по-прежнему перебивается флагом запуска:
;   godot --rendering-method gl_compatibility --path client
; и той же строкой .mobile ниже — она отвечает не за «мобильный рендерер», а за
; сборки под мобильную платформу, где Forward+ не поднимается.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
